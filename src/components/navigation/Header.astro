---
// src/components/navigation/Header.astro
//
// Globale Navigation – auf jeder Seite über BaseLayout eingebunden.
// Navigationsstruktur kommt aus navData.ts (Single Source of Truth).
//
// Besonderheit "Contact Us":
//   href="#contact" → Anker-Link, kein Seitennavigation.
//   isActive() gibt false zurück (Anker ≠ Pfad) → kein aria-current.
//   Das Mobile-Menü schließt auch bei Hash-Links per JS (siehe <script>).

import { globalNavItems as navItems } from "./navData";

const currentPath = new URL(Astro.request.url).pathname;

function isActive(href: string): boolean {
  // Hash-Links (#...) sind nie "aktiv" im Sinne der aktuellen Seite
  if (!href || href.startsWith("#")) return false;
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}

// Ein Gruppeneintrag ("Locations") gilt als aktiv, sobald einer seiner
// Untereinträge die aktuelle Seite ist.
function isGroupActive(item: { children?: { href: string }[] }): boolean {
  return (item.children ?? []).some(child => isActive(child.href));
}
---

<header class="site-header">
  <div class="container site-header__inner">

    <!-- Logo -->
    <a href="/" class="site-header__logo" aria-label="OneAIM – Startseite">
      <img
        src="/logo.png"
        alt="OneAIM Logo"
        class="site-header__logo-img"
        height="44"
        decoding="async"
      />
    </a>

    <!-- Desktop-Navigation -->
    <nav class="site-header__nav" aria-label="Hauptnavigation">
      <ul class="site-header__nav-list">
        {navItems.map(item => item.children ? (
          <li class="site-header__dropdown">
            <button
              type="button"
              class="site-header__nav-link site-header__dropdown-toggle"
              aria-expanded="false"
              aria-haspopup="true"
              data-group={item.label}
              data-current={isGroupActive(item) ? "true" : undefined}
            >
              {item.label}
              <svg class="site-header__caret" viewBox="0 0 12 12" width="10" height="10"
                   aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M1.5 4l4.5 4.5L10.5 4H1.5z"/>
              </svg>
            </button>
            <ul class="site-header__dropdown-menu">
              {item.children.map(child => (
                <li>
                  <a
                    href={child.href}
                    class="site-header__dropdown-link"
                    aria-current={isActive(child.href) ? "page" : undefined}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a
              href={item.href}
              class="site-header__nav-link"
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Aktionen: LinkedIn-Icon + Burger-Button -->
    <div class="site-header__actions">
      <a
        href="https://www.linkedin.com/company/oneaim"
        class="site-header__icon-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="OneAIM auf LinkedIn (öffnet in neuem Tab)"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor"
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14
               1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85
               3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06
               0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
        </svg>
      </a>

      <button
        type="button"
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menü öffnen"
        id="menu-toggle"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile-Navigation (via Burger-Menü) -->
  <nav
    id="mobile-nav"
    class="site-header__mobile-nav"
    aria-label="Mobile Hauptnavigation"
    hidden
  >
    <ul class="site-header__mobile-list">
      {navItems.map(item => item.children ? (
        <li>
          {/* Kein Dropdown im Mobilmenü: die Standorte stehen direkt
              untereinander, das spart einen zusätzlichen Tap. */}
          <span class="site-header__mobile-group">{item.label}</span>
          <ul>
            {item.children.map(child => (
              <li>
                <a
                  href={child.href}
                  class="site-header__mobile-link site-header__mobile-link--child"
                  aria-current={isActive(child.href) ? "page" : undefined}
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li>
          <a
            href={item.href}
            class="site-header__mobile-link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* ── Äußerer Header ───────────────────────────────────────── */
  .site-header {
    position:         sticky;
    top:              0;
    z-index:          100;
    background:       rgba(255, 255, 255, 0.92);
    backdrop-filter:  blur(8px);
    box-shadow:       var(--shadow-header);
  }

  /* ── Innere Zeile: Logo | Nav | Aktionen ──────────────────── */
  .site-header__inner {
    display:     flex;
    align-items: center;
    justify-content: space-between;
    height:      var(--header-height);
    gap:         var(--space-6);
  }

  /* ── Logo ─────────────────────────────────────────────────── */
  .site-header__logo {
    display:     flex;
    align-items: center;
    gap:         var(--space-2);
    flex-shrink: 0;
    color:       var(--color-brand-blue);
  }

  .site-header__logo:hover { text-decoration: none; opacity: 0.88; }

  .site-header__logo-img {
    width:      auto;
    height:     44px;
    display:    block;
    object-fit: contain;
    transition: opacity var(--transition-fast);
  }

  /* ── Desktop-Nav ──────────────────────────────────────────── */
  .site-header__nav {
    flex:            1;
    display:         flex;
    justify-content: center;
  }

  .site-header__nav-list {
    display:     flex;
    align-items: center;
    gap:         var(--space-6);
  }

  .site-header__nav-link {
    font-size:   15px;
    font-weight: var(--fw-semibold);
    color:       var(--color-text-heading);
    padding:     var(--space-2) var(--space-1);
    white-space: nowrap;
    transition:  color var(--transition-fast);
  }

  .site-header__nav-link:hover { color: var(--color-brand-blue); text-decoration: none; }

  .site-header__nav-link[aria-current="page"] {
    color: var(--color-brand-blue);
  }

  /* ── Locations-Dropdown ───────────────────────────────────────
     Öffnet bei Hover, bei Tastaturfokus (:focus-within) und per
     Klick (.is-open, gesetzt vom Script). Der Klick-Pfad ist für
     Touch-Geräte nötig, die kein Hover kennen.                    */
  .site-header__dropdown { position: relative; }

  .site-header__dropdown-toggle {
    display:     inline-flex;
    align-items: center;
    gap:         6px;
    background:  none;
    border:      none;
    font-family: var(--font-display);
  }

  .site-header__dropdown-toggle[data-current="true"] { color: var(--color-brand-blue); }

  .site-header__caret {
    transition: transform var(--transition-fast);
  }

  .site-header__dropdown:hover .site-header__caret,
  .site-header__dropdown:focus-within .site-header__caret,
  .site-header__dropdown.is-open .site-header__caret {
    transform: rotate(180deg);
  }

  .site-header__dropdown-menu {
    position:      absolute;
    top:           100%;
    left:          50%;
    transform:     translateX(-50%) translateY(-4px);
    min-width:     180px;
    /* Der Abstand liegt als padding INNEN, damit zwischen Button und
       Menü keine Lücke entsteht, über der der Hover abreißt. */
    margin-top:    0;
    padding:       var(--space-2);
    background:    var(--color-bg-surface);
    border:        1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    box-shadow:    var(--shadow-lift);
    opacity:       0;
    visibility:    hidden;
    transition:    opacity var(--transition-fast), transform var(--transition-fast),
                   visibility var(--transition-fast);
    z-index:       10;
  }

  .site-header__dropdown:hover .site-header__dropdown-menu,
  .site-header__dropdown:focus-within .site-header__dropdown-menu,
  .site-header__dropdown.is-open .site-header__dropdown-menu {
    opacity:    1;
    visibility: visible;
    transform:  translateX(-50%) translateY(0);
  }

  .site-header__dropdown-link {
    display:       block;
    padding:       var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size:     15px;
    font-weight:   var(--fw-semibold);
    color:         var(--color-text-heading);
    white-space:   nowrap;
    transition:    background var(--transition-fast), color var(--transition-fast);
  }

  .site-header__dropdown-link:hover {
    background:      #F7F9FE;
    color:           var(--color-brand-blue);
    text-decoration: none;
  }

  .site-header__dropdown-link[aria-current="page"] { color: var(--color-brand-blue); }

  /* ── Aktionen (Icon + Burger) ─────────────────────────────── */
  .site-header__actions {
    display:     flex;
    align-items: center;
    gap:         var(--space-4);
    flex-shrink: 0;
  }

  .site-header__icon-link {
    display:       inline-flex;
    color:         var(--color-text-heading);
    padding:       var(--space-1);
    border-radius: var(--radius-sm);
    transition:    color var(--transition-fast);
  }

  .site-header__icon-link:hover { color: var(--color-brand-blue); text-decoration: none; }

  .site-header__menu-toggle {
    display:       none;
    align-items:   center;
    justify-content: center;
    background:    none;
    border:        none;
    color:         var(--color-text-heading);
    padding:       var(--space-2);
    border-radius: var(--radius-sm);
    cursor:        pointer;
  }

  /* ── Mobile-Menü ──────────────────────────────────────────── */
  .site-header__mobile-nav {
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-bg-surface);
  }

  .site-header__mobile-list {
    display:        flex;
    flex-direction: column;
    padding:        var(--space-2) var(--container-padding) var(--space-4);
  }

  .site-header__mobile-link {
    display:       block;
    padding:       var(--space-3) var(--space-1);
    font-size:     1.2rem;
    font-weight:   var(--fw-bold);
    color:         var(--color-brand-blue);
    border-bottom: 1px solid var(--color-border-subtle);
    transition:    color var(--transition-fast);
  }

  .site-header__mobile-link[aria-current="page"] {
    color: var(--color-text-heading);
  }

  .site-header__mobile-group {
    display:        block;
    padding:        var(--space-3) var(--space-1) var(--space-1);
    font-size:      var(--fs-small);
    font-weight:    var(--fw-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--color-text-muted);
  }

  .site-header__mobile-link--child { padding-left: var(--space-4); }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 880px) {
    .site-header__nav       { display: none; }
    .site-header__menu-toggle { display: inline-flex; }
  }

  @media (min-width: 881px) {
    .site-header__mobile-nav { display: none !important; }
  }
</style>

<script>
  const toggle    = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  // ── Locations-Dropdown ─────────────────────────────────────
  //
  // Hover und Tastaturfokus erledigt CSS. Hier kommt nur der Klick-Pfad
  // dazu: Touch-Geräte kennen kein Hover, dort wäre das Menü sonst nicht
  // erreichbar.

  const dropdowns = Array.from(
    document.querySelectorAll<HTMLElement>(".site-header__dropdown")
  );

  function closeDropdowns(except?: HTMLElement) {
    dropdowns.forEach(d => {
      if (d === except) return;
      d.classList.remove("is-open");
      d.querySelector(".site-header__dropdown-toggle")
        ?.setAttribute("aria-expanded", "false");
    });
  }

  dropdowns.forEach(dropdown => {
    const trigger = dropdown.querySelector(".site-header__dropdown-toggle");

    trigger?.addEventListener("click", () => {
      const isOpen = dropdown.classList.toggle("is-open");
      trigger.setAttribute("aria-expanded", String(isOpen));
      closeDropdowns(dropdown);
    });

    // Verlässt der Fokus die Gruppe per Tab, schließt sie wieder.
    dropdown.addEventListener("focusout", event => {
      const next = event.relatedTarget as Node | null;
      if (next && dropdown.contains(next)) return;
      dropdown.classList.remove("is-open");
      trigger?.setAttribute("aria-expanded", "false");
    });
  });

  // Klick irgendwo sonst schließt offene Dropdowns.
  document.addEventListener("click", event => {
    const target = event.target as Node;
    if (!dropdowns.some(d => d.contains(target))) closeDropdowns();
  });

  // ── Burger-Toggle ──────────────────────────────────────────

  function openMenu() {
    mobileNav?.removeAttribute("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute("aria-label", "Menü schließen");
  }

  function closeMenu() {
    mobileNav?.setAttribute("hidden", "");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Menü öffnen");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  // ── Menü schließen wenn Link geklickt ─────────────────────
  //
  // Bei normalen Links schließt das Menü automatisch durch den
  // Seitenneulad. Bei Hash-Links (#contact) bleibt die Seite
  // identisch – daher müssen wir das Menü explizit schließen.

  mobileNav?.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => closeMenu());
  });

  // ── Menü schließen bei Resize auf Desktop-Breite ──────────

  window.matchMedia("(min-width: 881px)").addEventListener("change", e => {
    if (e.matches) closeMenu();
  });

  // ── Escape-Taste schließt Menü ─────────────────────────────

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    if (toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle?.focus();   // Fokus zurück auf den Toggle-Button
    }
    closeDropdowns();
  });
</script>
