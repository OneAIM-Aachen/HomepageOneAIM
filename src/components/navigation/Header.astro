---
// src/components/navigation/Header.astro
//
// Globale Navigation – auf jeder Seite über BaseLayout eingebunden.
// Navigationsstruktur kommt aus navData.ts (Single Source of Truth).
//
// Besonderheit "Contact Us":
//   href="#contact" → Anker-Link, kein Seitennavigation.
//   isActive() gibt false zurück (Anker ≠ Pfad) → kein aria-current.
//   Das Mobile-Menü schließt auch bei Hash-Links per JS (siehe <script>).

import { globalNavItems as navItems } from "./navData";

const currentPath = new URL(Astro.request.url).pathname;

function isActive(href: string): boolean {
  // Hash-Links (#...) sind nie "aktiv" im Sinne der aktuellen Seite
  if (href.startsWith("#")) return false;
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<header class="site-header">
  <div class="container site-header__inner">

    <!-- Logo -->
    <a href="/" class="site-header__logo" aria-label="OneAIM – Startseite">
      <img
        src="/logo.png"
        alt="OneAIM Logo"
        class="site-header__logo-img"
        height="44"
        decoding="async"
      />
    </a>

    <!-- Desktop-Navigation -->
    <nav class="site-header__nav" aria-label="Hauptnavigation">
      <ul class="site-header__nav-list">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class="site-header__nav-link"
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Aktionen: LinkedIn-Icon + Burger-Button -->
    <div class="site-header__actions">
      <a
        href="https://www.linkedin.com/company/oneaim"
        class="site-header__icon-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="OneAIM auf LinkedIn (öffnet in neuem Tab)"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor"
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14
               1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85
               3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06
               0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
        </svg>
      </a>

      <button
        type="button"
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menü öffnen"
        id="menu-toggle"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile-Navigation (via Burger-Menü) -->
  <nav
    id="mobile-nav"
    class="site-header__mobile-nav"
    aria-label="Mobile Hauptnavigation"
    hidden
  >
    <ul class="site-header__mobile-list">
      {navItems.map(item => (
        <li>
          <a
            href={item.href}
            class="site-header__mobile-link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* ── Äußerer Header ───────────────────────────────────────── */
  .site-header {
    position:         sticky;
    top:              0;
    z-index:          100;
    background:       rgba(255, 255, 255, 0.92);
    backdrop-filter:  blur(8px);
    box-shadow:       var(--shadow-header);
  }

  /* ── Innere Zeile: Logo | Nav | Aktionen ──────────────────── */
  .site-header__inner {
    display:     flex;
    align-items: center;
    justify-content: space-between;
    height:      var(--header-height);
    gap:         var(--space-6);
  }

  /* ── Logo ─────────────────────────────────────────────────── */
  .site-header__logo {
    display:     flex;
    align-items: center;
    gap:         var(--space-2);
    flex-shrink: 0;
    color:       var(--color-brand-blue);
  }

  .site-header__logo:hover { text-decoration: none; opacity: 0.88; }

  .site-header__logo-img {
    width:      auto;
    height:     44px;
    display:    block;
    object-fit: contain;
    transition: opacity var(--transition-fast);
  }

  /* ── Desktop-Nav ──────────────────────────────────────────── */
  .site-header__nav {
    flex:            1;
    display:         flex;
    justify-content: center;
  }

  .site-header__nav-list {
    display:     flex;
    align-items: center;
    gap:         var(--space-6);
  }

  .site-header__nav-link {
    font-size:   1.05rem;
    font-weight: var(--fw-bold);
    color:       var(--color-brand-blue);
    padding:     var(--space-2) var(--space-1);
    white-space: nowrap;
    transition:  color var(--transition-fast);
  }

  .site-header__nav-link:hover { text-decoration: underline; }

  .site-header__nav-link[aria-current="page"] {
    color:                   var(--color-text-heading);
    text-decoration:         underline;
    text-decoration-thickness: 2px;
    text-underline-offset:   4px;
  }

  /* ── Aktionen (Icon + Burger) ─────────────────────────────── */
  .site-header__actions {
    display:     flex;
    align-items: center;
    gap:         var(--space-4);
    flex-shrink: 0;
  }

  .site-header__icon-link {
    display:       inline-flex;
    color:         var(--color-text-heading);
    padding:       var(--space-1);
    border-radius: var(--radius-sm);
    transition:    color var(--transition-fast);
  }

  .site-header__icon-link:hover { color: var(--color-brand-blue); text-decoration: none; }

  .site-header__menu-toggle {
    display:       none;
    align-items:   center;
    justify-content: center;
    background:    none;
    border:        none;
    color:         var(--color-text-heading);
    padding:       var(--space-2);
    border-radius: var(--radius-sm);
    cursor:        pointer;
  }

  /* ── Mobile-Menü ──────────────────────────────────────────── */
  .site-header__mobile-nav {
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-bg-surface);
  }

  .site-header__mobile-list {
    display:        flex;
    flex-direction: column;
    padding:        var(--space-2) var(--container-padding) var(--space-4);
  }

  .site-header__mobile-link {
    display:       block;
    padding:       var(--space-3) var(--space-1);
    font-size:     1.2rem;
    font-weight:   var(--fw-bold);
    color:         var(--color-brand-blue);
    border-bottom: 1px solid var(--color-border-subtle);
    transition:    color var(--transition-fast);
  }

  .site-header__mobile-link[aria-current="page"] {
    color: var(--color-text-heading);
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 880px) {
    .site-header__nav       { display: none; }
    .site-header__menu-toggle { display: inline-flex; }
  }

  @media (min-width: 881px) {
    .site-header__mobile-nav { display: none !important; }
  }
</style>

<script>
  const toggle    = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  // ── Burger-Toggle ──────────────────────────────────────────

  function openMenu() {
    mobileNav?.removeAttribute("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute("aria-label", "Menü schließen");
  }

  function closeMenu() {
    mobileNav?.setAttribute("hidden", "");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Menü öffnen");
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  // ── Menü schließen wenn Link geklickt ─────────────────────
  //
  // Bei normalen Links schließt das Menü automatisch durch den
  // Seitenneulad. Bei Hash-Links (#contact) bleibt die Seite
  // identisch – daher müssen wir das Menü explizit schließen.

  mobileNav?.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => closeMenu());
  });

  // ── Menü schließen bei Resize auf Desktop-Breite ──────────

  window.matchMedia("(min-width: 881px)").addEventListener("change", e => {
    if (e.matches) closeMenu();
  });

  // ── Escape-Taste schließt Menü ─────────────────────────────

  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle?.focus();   // Fokus zurück auf den Toggle-Button
    }
  });
</script>
