---
// src/components/navigation/CityTabs.astro
// Lokale Navigation innerhalb eines Standorts (München/Aachen).
// Struktur identisch für beide Städte – nur citySlug ändert sich.

import { getCityNavItems } from "./navData";
import type { CitySlug } from "../../data/cityData";

interface Props {
  citySlug: CitySlug;
}

const { citySlug } = Astro.props;
const items = getCityNavItems(citySlug);
const currentPath = new URL(Astro.request.url).pathname;

function isActive(href: string): boolean {
  // Übersicht nur aktiv, wenn exakt auf der Hub-Seite.
  if (href === `/${citySlug}`) return currentPath === href;
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<nav class="city-tabs" aria-label={`Navigation innerhalb ${citySlug === "muenchen" ? "München" : "Aachen"}`}>
  <ul class="city-tabs__list">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            class="city-tabs__link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .city-tabs {
    background: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .city-tabs__list {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    padding-inline: var(--container-padding);
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .city-tabs__link {
    display: inline-block;
    padding: var(--space-4) var(--space-1);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text-body);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }

  .city-tabs__link:hover {
    color: var(--color-brand-blue);
    text-decoration: none;
  }

  .city-tabs__link[aria-current="page"] {
    color: var(--color-brand-blue);
    border-bottom-color: var(--color-brand-blue);
    font-weight: var(--fw-bold);
  }
</style>
