---
// src/components/navigation/Footer.astro

const year = new Date().getFullYear();

const footerLinks = [
  { label: "Contact Us",    href: "/contact",      external: false },
  { label: "Datenschutz",   href: "/datenschutz",  external: false },
  { label: "Impressum",     href: "/impressum",    external: false },
  {
    label: "LinkedIn",
    href:  "https://www.linkedin.com/company/oneaim",
    external: true,
  },
];
---

<footer class="site-footer">

  <div class="site-footer__base">
    <div class="container site-footer__base-inner">
      <nav aria-label="Footer-Navigation">
        <ul class="site-footer__links">
          {footerLinks.map(link => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
                {link.external && (
                  <span class="visually-hidden"> (öffnet in neuem Tab)</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="site-footer__copyright">© OneAIM {year}. All Rights Reserved.</p>
    </div>
  </div>

</footer>

<style>

  .site-footer__base {
    background:    var(--color-bg-footer);
    color:         var(--color-text-on-dark);
    padding-block: var(--space-8);
  }

  .site-footer__base-inner {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
  }

  .site-footer__links {
    display:   flex;
    flex-wrap: wrap;
    gap:       var(--space-6);
  }

  .site-footer__links a {
    color:      var(--color-text-on-dark);
    font-size:  var(--fs-small);
    transition: color var(--transition-fast);
  }

  .site-footer__links a:hover { color: var(--color-brand-blue); text-decoration: none; }

  .site-footer__copyright {
    font-size: var(--fs-caption);
    color:     rgba(245, 245, 247, 0.55);
  }
</style>
