---
// src/components/navigation/Footer.astro
// Globaler Footer.
// Newsletter-CTA-Block trägt id="contact" für direkten Anker-Zugriff.
// Der "Contact Us"-Link in der Fußzeile verweist auf /contact.

const year = new Date().getFullYear();

const footerLinks = [
  { label: "Contact Us", href: "/contact",                             external: false },
  { label: "Impressum",  href: "/impressum",                           external: false },
  {
    label: "LinkedIn",
    href:  "https://www.linkedin.com/company/oneaim",
    external: true,
  },
];
---

<footer class="site-footer">

  <section
    id="contact"
    class="site-footer__cta"
    aria-labelledby="contact-heading"
  >
    <div class="container site-footer__cta-inner">
      <h2 id="contact-heading">Stay Connected</h2>
      <p class="site-footer__cta-sub">
        Sign up to our newsletter to receive news about events, workshops and more.
      </p>

      <form class="site-footer__form" aria-label="Newsletter-Anmeldung" novalidate>
        <div class="site-footer__field">
          <label for="footer-first-name">First Name:</label>
          <input id="footer-first-name" name="firstName" type="text"
                 autocomplete="given-name" required />
        </div>
        <div class="site-footer__field">
          <label for="footer-last-name">Last Name:</label>
          <input id="footer-last-name" name="lastName" type="text"
                 autocomplete="family-name" required />
        </div>
        <div class="site-footer__field site-footer__field--full">
          <label for="footer-email">Email address:</label>
          <input id="footer-email" name="email" type="email"
                 autocomplete="email" required />
        </div>
        <div class="site-footer__field--full">
          <button type="submit" class="site-footer__submit">Notify me</button>
        </div>
      </form>
    </div>
  </section>

  <div class="site-footer__base">
    <div class="container site-footer__base-inner">
      <nav aria-label="Footer-Navigation">
        <ul class="site-footer__links">
          {footerLinks.map(link => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
                {link.external && (
                  <span class="visually-hidden"> (öffnet in neuem Tab)</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="site-footer__copyright">© OneAIM {year}. All Rights Reserved.</p>
    </div>
  </div>

</footer>

<style>
  .site-footer__cta {
    background:        var(--color-bg-footer-cta);
    color:             var(--color-text-on-brand);
    padding-block:     var(--space-24) var(--space-16);
    text-align:        center;
    scroll-margin-top: var(--header-height);
  }

  .site-footer__cta-inner { max-width: 640px; }

  .site-footer__cta h2 {
    color:         var(--color-text-on-brand);
    margin-bottom: var(--space-3);
  }

  .site-footer__cta-sub {
    font-size:     var(--fs-body-lg);
    color:         rgba(255, 255, 255, 0.90);
    margin-bottom: var(--space-8);
  }

  .site-footer__form {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
    text-align:     left;
  }

  .site-footer__field label {
    display:       block;
    font-size:     var(--fs-small);
    font-weight:   var(--fw-medium);
    margin-bottom: var(--space-2);
  }

  .site-footer__field input {
    width:         100%;
    padding:       var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    border:        1px solid transparent;
    font-size:     var(--fs-body);
    background:    var(--color-bg-surface);
    color:         var(--color-text-heading);
    font-family:   var(--font-body);
  }

  .site-footer__field input:focus-visible {
    outline:    none;
    box-shadow: var(--focus-ring-on-dark);
  }

  .site-footer__submit {
    align-self:    flex-start;
    padding:       var(--space-3) var(--space-8);
    background:    var(--color-accent-purple);
    color:         var(--color-text-on-brand);
    border:        none;
    border-radius: var(--radius-sm);
    font-family:   var(--font-display);
    font-weight:   var(--fw-bold);
    font-size:     var(--fs-body);
    cursor:        pointer;
    transition:    background var(--transition-fast);
  }

  .site-footer__submit:hover { background: var(--color-accent-purple-dark); }

  .site-footer__submit:focus-visible {
    outline:    none;
    box-shadow: var(--focus-ring-on-dark);
  }

  @media (min-width: 560px) {
    .site-footer__form {
      display:               grid;
      grid-template-columns: 1fr 1fr;
      column-gap:            var(--space-4);
    }
    .site-footer__field--full { grid-column: 1 / -1; }
  }

  .site-footer__base {
    background:    var(--color-bg-footer);
    color:         var(--color-text-on-dark);
    padding-block: var(--space-8);
  }

  .site-footer__base-inner {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
  }

  .site-footer__links {
    display:   flex;
    flex-wrap: wrap;
    gap:       var(--space-6);
  }

  .site-footer__links a {
    color:      var(--color-text-on-dark);
    font-size:  var(--fs-small);
    transition: color var(--transition-fast);
  }

  .site-footer__links a:hover {
    color:           var(--color-brand-blue);
    text-decoration: none;
  }

  .site-footer__copyright {
    font-size: var(--fs-caption);
    color:     rgba(245, 245, 247, 0.55);
  }
</style>
