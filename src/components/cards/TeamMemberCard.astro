---
// src/components/cards/TeamMemberCard.astro
// Einzelne Karte für ein Team-Mitglied. Wiederverwendet auf allen
// Team-Seiten (München & Aachen).

interface Props {
  name: string;
  role: string;
}

const { name, role } = Astro.props;

const initials = name
  .split(" ")
  .map((part) => part[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<li class="team-card">
  <div class="team-card__avatar" aria-hidden="true">{initials}</div>
  <p class="team-card__name">{name}</p>
  <p class="team-card__role">{role}</p>
</li>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .team-card__avatar {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-pill);
    background: var(--gradient-icon);
    color: var(--color-text-on-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-bold);
    font-size: var(--fs-h3);
  }

  .team-card__name {
    font-weight: var(--fw-bold);
    color: var(--color-text-heading);
  }

  .team-card__role {
    font-size: var(--fs-small);
    color: var(--color-text-body);
  }
</style>
