---
// src/components/cards/ListItemCard.astro
// Wiederverwendbares Listen-Element für News UND Publications.
// "meta" ist eine fertig formatierte Zeile (z. B. Datum oder "Autoren · Jahr"),
// damit die Karte für beide Inhaltstypen identisch bleibt.

import DummyNotice from "../ui/DummyNotice.astro";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  meta: string;
  description: string;
  isDummy?: boolean;
  cta?: Cta;
}

const { title, meta, description, isDummy = false, cta } = Astro.props;
---

<li class="list-item-card">
  <div class="list-item-card__header">
    <p class="list-item-card__meta">{meta}</p>
    {isDummy && <DummyNotice variant="inline" />}
  </div>

  <h3 class="list-item-card__title">{title}</h3>
  <p class="list-item-card__description">{description}</p>

  {
    cta && (
      <a href={cta.href} class="list-item-card__cta">
        {cta.label} →
      </a>
    )
  }
</li>

<style>
  .list-item-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .list-item-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .list-item-card__meta {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-brand-blue);
  }

  .list-item-card__title {
    color: var(--color-text-heading);
  }

  .list-item-card__description {
    color: var(--color-text-body);
  }

  .list-item-card__cta {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-brand-blue);
    align-self: flex-start;
  }
</style>
