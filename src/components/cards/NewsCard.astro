---
// src/components/cards/NewsCard.astro
//
// ─────────────────────────────────────────────────────────────────────────────
// Reusable news card. Usable independently of the news page.
//
// VARIANTS:
//   variant="horizontal" (default) – image left, text right (desktop)
//                                      image top, text below (mobile)
//   variant="vertical"              – image always on top, text below
//                                      Ideal for "Latest News" sections
//
// USAGE:
//   import NewsCard from "../components/cards/NewsCard.astro";
//   <NewsCard {...newsItem} />
//   <NewsCard {...newsItem} variant="vertical" />
// ─────────────────────────────────────────────────────────────────────────────

interface Props {
  title:     string;
  date:      string;      // ISO: YYYY-MM-DD
  excerpt:   string;
  image:     string;
  imageAlt?: string;
  tags:      string[];
  variant?:  "horizontal" | "vertical";
  /** Dummy marker: shows a small "Platzhalter" badge */
  isDummy?:  boolean;
}

const {
  title,
  date,
  excerpt,
  image,
  imageAlt = "News-Vorschaubild",
  tags,
  variant  = "horizontal",
  isDummy  = false,
} = Astro.props;

// Format the date
const formattedDate = new Intl.DateTimeFormat("de-DE", {
  day:   "2-digit",
  month: "long",
  year:  "numeric",
}).format(new Date(date));

// ── Tag categorization for coloring ─────────────────────────────────────────
// Known categories yield matching CSS classes.
// Unknown tags receive the class "tag--default".
// New categories: simply extend the function.

type TagCategory = "location" | "program" | "event" | "research" | "default";

function getTagCategory(tag: string): TagCategory {
  const locations = ["Munich", "Aachen"];
  const programs  = ["AIM Connect", "AIM Code", "AIM Innovate", "AIM Educate"];
  const events    = ["Event", "Workshop", "Conference", "Makeathon", "Summit"];
  const research  = ["Research", "Partnership", "Announcement"];

  if (locations.includes(tag)) return "location";
  if (programs.includes(tag))  return "program";
  if (events.includes(tag))    return "event";
  if (research.includes(tag))  return "research";
  return "default";
}
---

<article class={`news-card news-card--${variant}`}>
  <!-- ── Image ─────────────────────────────────────────────────── -->
  <div class="news-card__img-wrap">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- ── Content ───────────────────────────────────────────────── -->
  <div class="news-card__body">

    <!-- Tags (above the title) -->
    {tags.length > 0 && (
      <ul class="news-card__tags" aria-label="Tags">
        {tags.map(tag => (
          <li>
            <span class={`news-card__tag news-card__tag--${getTagCategory(tag)}`}>
              {tag}
            </span>
          </li>
        ))}
        {isDummy && (
          <li>
            <span class="news-card__tag news-card__tag--dummy">Platzhalter</span>
          </li>
        )}
      </ul>
    )}

    <!-- Title -->
    <h3 class="news-card__title">{title}</h3>

    <!-- Date -->
    <time class="news-card__date" datetime={date}>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <rect x="1" y="2" width="14" height="13" rx="2" fill="none"
          stroke="currentColor" stroke-width="1.4"/>
        <line x1="1" y1="6" x2="15" y2="6" stroke="currentColor" stroke-width="1.4"/>
        <line x1="5" y1="0.5" x2="5" y2="4" stroke="currentColor"
          stroke-width="1.4" stroke-linecap="round"/>
        <line x1="11" y1="0.5" x2="11" y2="4" stroke="currentColor"
          stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      {formattedDate}
    </time>

    <!-- Description -->
    <p class="news-card__excerpt">{excerpt}</p>

  </div>
</article>

<style>
  /* ── Base card ────────────────────────────────────────────── */
  .news-card {
    background:    var(--color-bg-surface);
    border-radius: var(--radius-md);
    border:        1px solid var(--color-border-subtle);
    box-shadow:    var(--shadow-card);
    overflow:      hidden;
    transition:
      box-shadow var(--transition-fast),
      transform  var(--transition-fast);
  }

  .news-card:hover {
    box-shadow: 0 6px 28px rgba(0, 82, 233, 0.12);
    transform:  translateY(-2px);
  }

  /* ── Horizontal variant: image left / text right ─────────────
     On narrow screens: image top / text below                   */
  .news-card--horizontal {
    display: grid;
    grid-template-columns: 280px 1fr;
    min-height: 220px;
  }

  @media (max-width: 720px) {
    .news-card--horizontal {
      grid-template-columns: 1fr;
    }
  }

  /* ── Vertical variant: image always on top ──────────────────── */
  .news-card--vertical {
    display:        flex;
    flex-direction: column;
  }

  /* ── Image container ──────────────────────────────────────── */
  .news-card__img-wrap {
    overflow:    hidden;
    flex-shrink: 0;
  }

  /* Horizontal: full card height, fixed width via grid */
  .news-card--horizontal .news-card__img-wrap {
    height: 100%;
    min-height: 200px;
  }

  /* Vertical: fixed aspect-ratio-like height */
  .news-card--vertical .news-card__img-wrap {
    height: 200px;
  }

  .news-card__img-wrap img {
    width:       100%;
    height:      100%;
    object-fit:  cover;
    display:     block;
    transition:  transform 0.4s ease;
  }

  .news-card:hover .news-card__img-wrap img {
    transform: scale(1.03);
  }

  /* ── Text area ────────────────────────────────────────────── */
  .news-card__body {
    padding:        var(--space-6);
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
  }

  /* ── Tag list ─────────────────────────────────────────────── */
  .news-card__tags {
    display:   flex;
    flex-wrap: wrap;
    gap:       var(--space-2);
    list-style: none;
    margin:    0;
    padding:   0;
  }

  /* Base badge for all tags */
  .news-card__tag {
    display:       inline-block;
    padding:       3px var(--space-3);
    border-radius: var(--radius-pill);
    font-family:   var(--font-display);
    font-size:     var(--fs-caption);
    font-weight:   var(--fw-semibold);
    letter-spacing: 0.02em;
    line-height:   1.5;
    white-space:   nowrap;
  }

  /* Location tags: light blue / dark blue */
  .news-card__tag--location {
    background: #EEF3FF;
    color:      var(--color-brand-blue-dark);
  }

  /* Program tags: purple tones */
  .news-card__tag--program {
    background: #F3E8FF;
    color:      var(--color-accent-purple);
  }

  /* Event tags: pink tones */
  .news-card__tag--event {
    background: #FFE8F5;
    color:      #9B0058;
  }

  /* Research / Partnership: green tones */
  .news-card__tag--research {
    background: #E6F5E6;
    color:      #1A6B1A;
  }

  /* Unknown tags: neutral color */
  .news-card__tag--default {
    background: var(--color-bg-subtle);
    color:      var(--color-text-muted);
  }

  /* Placeholder badge */
  .news-card__tag--dummy {
    background: var(--color-warning-bg);
    color:      var(--color-warning-text);
    border:     1px solid var(--color-warning-border);
  }

  /* ── Title ────────────────────────────────────────────────── */
  .news-card__title {
    font-family:  var(--font-display);
    font-weight:  var(--fw-bold);
    font-size:    var(--fs-h3);
    color:        var(--color-text-heading);
    line-height:  1.25;
    margin:       0;
  }

  /* ── Date ─────────────────────────────────────────────────── */
  .news-card__date {
    display:     flex;
    align-items: center;
    gap:         var(--space-2);
    font-size:   var(--fs-small);
    font-weight: var(--fw-medium);
    color:       var(--color-text-muted);
    line-height: 1;
  }

  /* ── Description ──────────────────────────────────────────── */
  .news-card__excerpt {
    font-size:   var(--fs-body);
    color:       var(--color-text-body);
    line-height: var(--lh-body);
    margin:      0;
    /* For long texts: max 3 lines + ellipsis */
    display:            -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow:           hidden;
  }

  /* Vertical variant: more compact spacing */
  .news-card--vertical .news-card__body {
    padding: var(--space-4);
    gap:     var(--space-2);
  }

  .news-card--vertical .news-card__title {
    font-size: var(--fs-body);
  }

  .news-card--vertical .news-card__excerpt {
    -webkit-line-clamp: 2;
  }
</style>
