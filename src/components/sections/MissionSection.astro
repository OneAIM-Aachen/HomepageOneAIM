---
// src/components/sections/MissionSection.astro
// "Our Mission" – 2x2 Card-Grid, vgl. Screenshot "Our Mission".
// Inhalte sind eigene Kurzfassung der vier Themenfelder.

import IconCard from "../cards/IconCard.astro";

const missionCards = [
  {
    title: "Exploration",
    iconPath: "M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z",
    bullets: [
      { label: "Healthcare Challenges", text: "We expose participants to the most pressing issues in healthcare, fostering a deep understanding of the current landscape and where AI can make a difference." },
      { label: "Cross-Disciplinary Insights", text: "We offer a comprehensive understanding of the intersections between technology, medicine, and other key fields, helping participants see the full spectrum of opportunities in AI-driven healthcare." },
      { label: "Guidance from Experts", text: "We connect participants with experienced role models and advisors from diverse backgrounds, providing invaluable guidance and inspiration throughout their journey." },
    ],
  },
  {
    title: "Network",
    iconPath: "M17 9a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm-10 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm10 2c-2.2 0-6 1.1-6 3.3V17h12v-2.7C23 12.1 19.2 11 17 11zm-10 0c-2.2 0-6 1.1-6 3.3V17h7v-2.7c0-.9.3-1.9 1-2.7-.7-.4-1.4-.6-2-.6z",
    bullets: [
      { label: "Interdisciplinary Community", text: "We bring together students from various disciplines, creating a dynamic network that thrives on diverse perspectives and collaborative learning." },
      { label: "Lasting Connections", text: "We facilitate the formation of enduring relationships among participants, fostering a supportive community that extends beyond the program." },
      { label: "Alumni Expertise", text: "We actively involve our alumni network, ensuring participants benefit from the wisdom and experience of those who have walked this path before." },
    ],
  },
  {
    title: "Interaction",
    iconPath: "M4 4h16v12H7l-3 3z",
    bullets: [
      { label: "Mutual Empowerment", text: "We cultivate a respectful and supportive environment where participants empower each other, fostering both personal and collective growth." },
      { label: "Real-World Challenges", text: "We engage participants in hands-on experiences with real-world healthcare problems, allowing them to apply their knowledge in meaningful ways." },
      { label: "Navigating Complex Issues", text: "We offer expert advice and collaborative learning opportunities on complex topics like regulatory affairs, data privacy or ethical issues, ensuring participants are well-prepared for the intricacies of the field." },
    ],
  },
  {
    title: "Personal Development",
    iconPath: "M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z",
    bullets: [
      { label: "Social Connection", text: "We emphasize the importance of social events and community-building, creating a vibrant social club atmosphere where participants can connect and exchange ideas." },
      { label: "Advancement Opportunities", text: "We provide pathways for participants to advance within our organization, offering leadership roles and opportunities to shape the future of our initiative." },
      { label: "Soft Skills", text: "We focus on the development of essential soft skills, equipping participants with the communication, teamwork, and leadership abilities needed to thrive in their future careers." },
    ],
  },
];
---

<section class="mission-section" aria-labelledby="mission-heading">
  <div class="container">
    <h2 id="mission-heading" class="mission-section__heading">Our Mission</h2>

    <div class="mission-section__grid">
      {missionCards.map((card) => <IconCard title={card.title} bullets={card.bullets} iconPath={card.iconPath} />)}
    </div>
  </div>
</section>

<style>
  .mission-section {
    padding-block: var(--space-24);
    background: var(--color-bg-subtle);
  }

  .mission-section__heading {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .mission-section__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 760px) {
    .mission-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
