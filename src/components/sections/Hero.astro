---
// src/components/sections/Hero.astro
//
// Generic hero section.
// Background: existing gradient + slow wave animation via
// ::before / ::after CSS pseudo-elements.
// Colors stay fully identical – only the motion is new.


interface Props {
  headline:         string;
  subtext?:         string;
  /**
   * Prepared application data. Comes from CityLayout, which fetches it from
   * src/data/applications.ts – Hero itself does not know the database.
   */
  applicationData?: {
    status:   "open" | "upcoming" | "closed";
    deadline: string;
    opensAt:  string;
    link:     string;
  } | null;
  showLogo?:        boolean;
}

const { headline, subtext, applicationData = null, showLogo = false } = Astro.props;
---

<section class="hero" aria-label="Hero-Bereich">

  <!--
    Wave layers: two independently animated blobs that slowly
    drift over the background gradient.
    Sit below the content (z-index: 0), content is z-index: 1.
  -->
  <div class="hero__wave hero__wave--a" aria-hidden="true"></div>
  <div class="hero__wave hero__wave--b" aria-hidden="true"></div>

  <div class="container hero__inner">

    <!-- Logo (homepage only) -->
    {showLogo && (
      <img
        src="/logo.png"
        alt="OneAIM Logo"
        class="hero__logo"
        decoding="async"
        loading="eager"
      />
    )}

    <!-- Headline -->
    <h1 class:list={["hero__headline", showLogo && "hero__headline--with-logo"]}>
      {headline}
    </h1>

    <!-- Subtext -->
    {subtext && (
      <p class="hero__subtext">{subtext}</p>
    )}

    <!-- Slot: CTA buttons (homepage) -->
    {Astro.slots.has("default") && (
      <div class="hero__actions">
        <slot />
      </div>
    )}

    <!-- Application area (AIM Connect / overview) -->
    {applicationData !== null && (
      <aside class="hero__application" aria-label="Bewerbungsinformationen">
        {applicationData.status === "open" ? (
          <div class="hero__app-open">
            <div class="hero__app-badge" role="status" aria-live="polite">
              <span class="hero__app-dot" aria-hidden="true"></span>
              <span>Applications Open</span>
            </div>
            <p class="hero__app-text">
              Our application phase is open until{" "}
              <strong>{applicationData.deadline}</strong>!
            </p>
            <a
              href={applicationData.link}
              class="hero__app-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Jetzt bewerben – Bewerbungsschluss: ${applicationData.deadline}. Öffnet in neuem Tab.`}
            >
              Apply now
              <svg viewBox="0 0 16 16" width="14" height="14"
                   aria-hidden="true" focusable="false">
                <path fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round"
                      d="M3 8h10M9 4l4 4-4 4"/>
              </svg>
            </a>
          </div>
        ) : applicationData.status === "upcoming" ? (
          <p class="hero__app-closed" role="status" aria-live="polite">
            Applications open on <strong>{applicationData.opensAt}</strong>.
          </p>
        ) : (
          <p class="hero__app-closed" role="status" aria-live="polite">
            Applications are currently closed.
          </p>
        )}
      </aside>
    )}

  </div>
</section>

<style>
  /* ── Hero container ───────────────────────────────── */
  .hero {
    background:    var(--gradient-hero);
    padding-block: var(--space-24);
    min-height:    55vh;
    display:       flex;
    align-items:   center;

    /* Needed so the wave layers (absolute) do not run over the edge */
    position:      relative;
    overflow:      hidden;
  }

  /* ── Wave layers ──────────────────────────────────────────────────────
     Three gradient blobs drift slowly over the background.
     Colors stay identical – only position and brightness vary.

     Adjust speed:     increase animation-duration value = slower
     Adjust intensity: rgba opacity value (e.g. 0.40 → subtler/more prominent)
     Motion range:     translate() values in the @keyframes
  ──────────────────────────────────────────────────────────────────── */
  .hero__wave {
    position:       absolute;
    inset:         -40%;   /* larger than container → edges never visible */
    border-radius: 50%;
    pointer-events: none;
    z-index:       0;
    will-change:   transform;
  }

  /* Wave A: gentle blue blob – visible on a light background */
  .hero__wave--a {
    background: radial-gradient(
      ellipse 50% 45% at 25% 40%,
      rgba(0, 82, 233, 0.18) 0%,
      rgba(0, 82, 233, 0.05) 50%,
      transparent 70%
    );
    animation: wave-drift-a 8s ease-in-out infinite;
  }

  /* Wave B: gentle rose/pink blob */
  .hero__wave--b {
    background: radial-gradient(
      ellipse 48% 52% at 70% 60%,
      rgba(235, 100, 105, 0.20) 0%,
      rgba(212,   0, 255, 0.07) 50%,
      transparent 70%
    );
    animation: wave-drift-b 11s ease-in-out infinite;
  }

  /* ── Keyframes ────────────────────────────────────── */

  @keyframes wave-drift-a {
    0%   { transform: translate(0%,   0%)   scale(1.00); }
    25%  { transform: translate(10%,  6%)   scale(1.12); }
    50%  { transform: translate(6%,  12%)   scale(0.92); }
    75%  { transform: translate(-8%,  7%)   scale(1.08); }
    100% { transform: translate(0%,   0%)   scale(1.00); }
  }

  @keyframes wave-drift-b {
    0%   { transform: translate(0%,    0%)  scale(1.00); }
    30%  { transform: translate(-12%, -8%)  scale(1.14); }
    60%  { transform: translate(-6%,  10%)  scale(0.90); }
    80%  { transform: translate(9%,  -6%)   scale(1.10); }
    100% { transform: translate(0%,   0%)   scale(1.00); }
  }

  /* prefers-reduced-motion: disable the animation for users
     who have enabled "reduce motion" in their system settings.
     If you do NOT see the animation on localhost, check this setting
     in your operating system (macOS: System Settings → Accessibility). */
  @media (prefers-reduced-motion: reduce) {
    .hero__wave {
      animation: none;
    }
  }

  /* ── Content above the waves ──────────────────────── */
  .hero__inner {
    position:       relative;
    z-index:        1;   /* sits above the wave layers */
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            var(--space-4);
    text-align:     center;
  }

  /* ── Logo ─────────────────────────────────────────── */
  .hero__logo {
    width:      35vw;
    max-width:  448px;
    min-width:  140px;
    height:     auto;
    object-fit: contain;
  }

  /* ── Headline ─────────────────────────────────────── */
  .hero__headline {
    font-size:   var(--fs-display);
    font-weight: var(--fw-bold);
    color:       var(--color-brand-blue);
    line-height: var(--lh-heading);
    max-width:   820px;
  }

  .hero__headline--with-logo {
    font-size: var(--fs-h1);
  }

  /* ── Subtext ──────────────────────────────────────── */
  .hero__subtext {
    font-size:   var(--fs-h3);
    font-weight: var(--fw-medium);
    color:       var(--color-brand-blue-dark);
    max-width:   600px;
    margin:      0;
  }

  /* ── Slot buttons ─────────────────────────────────── */
  .hero__actions {
    display:         flex;
    gap:             var(--space-4);
    flex-wrap:       wrap;
    justify-content: center;
    margin-top:      var(--space-4);
  }

  /* ── Application area ─────────────────────────────── */
  .hero__application {
    margin-top:      var(--space-8);
    padding:         var(--space-6) var(--space-8);
    background:      rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(10px);
    border:          1px solid rgba(0, 82, 233, 0.15);
    border-radius:   var(--radius-md);
    max-width:       480px;
    width:           100%;
  }

  .hero__app-open {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            var(--space-4);
  }

  .hero__app-badge {
    display:     flex;
    align-items: center;
    gap:         var(--space-2);
    font-size:   var(--fs-small);
    font-weight: var(--fw-semibold);
    color:       var(--color-brand-blue-dark);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .hero__app-dot {
    display:       block;
    width:         10px;
    height:        10px;
    border-radius: var(--radius-pill);
    background:    #34D399;
    box-shadow:    0 0 0 0 rgba(52, 211, 153, 0.5);
    animation:     pulse-dot 2s ease-in-out infinite;
    flex-shrink:   0;
  }

  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 0   rgba(52, 211, 153, 0.50); }
    50%       { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0);    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__app-dot { animation: none; }
  }

  .hero__app-text {
    font-size:   var(--fs-body-lg);
    color:       var(--color-brand-blue-dark);
    line-height: var(--lh-body);
    margin:      0;
  }

  .hero__app-text strong {
    color:       var(--color-brand-blue);   /* date: strong blue, visible on a white background */
    font-weight: var(--fw-bold);
  }

  .hero__app-btn {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    padding:         var(--space-3) var(--space-8);
    background:      var(--color-brand-blue);
    color:           var(--color-text-on-brand);
    border-radius:   var(--radius-sm);
    font-family:     var(--font-display);
    font-weight:     var(--fw-bold);
    font-size:       var(--fs-body);
    line-height:     1;
    text-decoration: none;
    border:          none;
    transition:
      background var(--transition-fast),
      transform  var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .hero__app-btn:hover {
    background:      var(--color-brand-blue-dark);
    transform:       translateY(-1px);
    text-decoration: none;
    box-shadow:      0 4px 14px rgba(0, 82, 233, 0.30);
  }

  .hero__app-btn:focus-visible {
    outline:    none;
    box-shadow: var(--focus-ring);
  }

  .hero__app-closed {
    font-size:  var(--fs-body);
    color:      var(--color-text-muted);
    font-style: italic;
    margin:     0;
    text-align: center;
  }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 560px) {
    .hero__application {
      padding:   var(--space-4) var(--space-6);
      max-width: 100%;
    }

    .hero__app-text {
      font-size: var(--fs-body);
    }
  }
</style>
