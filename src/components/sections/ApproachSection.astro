---
// src/components/sections/ApproachSection.astro
// "Our Approach" – two-column layout, cf. the "What is AIM Connect?" pattern
// (headline + two cards). Standalone content for the homepage level.

import IconCard from "../cards/IconCard.astro";

const approachCards = [
  {
    title: "Practical Programs",
    iconPath: "M9 18l-5-5 1.4-1.4L9 15.2l9.6-9.6L20 7z",
    bullets: [
      { label: "Hands-On", text: "From coding boot camps to makeathons, learning takes place through real-world use cases." },
      { label: "Across all locations", text: "Munich and Aachen follow the same tried-and-true program structure." },
    ],
  },
  {
    title: "Interdisciplinary",
    iconPath: "M4 7h16M4 12h16M4 17h10",
    bullets: [
      { label: "Accessible", text: "Our programmes are free of charge and are open to students in all fields of study." },
      { label: "Mentoring", text: "Experienced mentors from the fields of medicine, technology, and business guide you every step of the way." },
    ],
  },
];
---

<section class="approach-section" aria-labelledby="approach-heading">
  <div class="container approach-section__inner">
    <div class="approach-section__intro">
      <h2 id="approach-heading">
        Our <span class="approach-section__accent">Approach</span>
      </h2>
      <p>
        We combine theory and practice through structured programs that directly connect students with
        the HealthTech industry, supported by mentoring, real-world projects, and a
        growing community.
      </p>
    </div>

    <div class="approach-section__cards">
      {approachCards.map((card) => <IconCard title={card.title} bullets={card.bullets} iconPath={card.iconPath} />)}
    </div>
  </div>
</section>

<style>
  .approach-section {
    padding-block: var(--space-24);
    background: var(--color-bg-page);
  }

  .approach-section__inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-12);
    align-items: start;
  }

  .approach-section__intro p {
    margin-top: var(--space-4);
    color: var(--color-text-body);
    font-size: var(--fs-body-lg);
  }

  .approach-section__accent {
    color: var(--color-brand-blue);
  }

  .approach-section__cards {
    display: grid;
    gap: var(--space-6);
  }

  @media (max-width: 880px) {
    .approach-section__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
