---
// src/components/sections/FAQSection.astro
//
// FAQ-Sektion: zweispaltig, ~80 % der Seitenbreite.
// Fragen werden im Frontmatter in zwei gleich große Hälften geteilt
// und nebeneinander in einem CSS-Grid gerendert.
// Inhalte kommen ausschließlich aus src/data/faq.ts.

import type { FAQItem } from "../../data/faq";

interface Props {
  items:       FAQItem[];
  heading?:    string;
  background?: "page" | "subtle" | "surface";
}

const {
  items,
  heading    = "FAQ",
  background = "subtle",
} = Astro.props;

// Array in zwei Hälften teilen – linke Spalte bekommt die erste Hälfte
const mid        = Math.ceil(items.length / 2);
const leftItems  = items.slice(0, mid);
const rightItems = items.slice(mid);
---

<section
  class={`faq-section faq-section--${background}`}
  aria-labelledby="faq-heading"
>
  <div class="faq-section__inner">

    <h2 id="faq-heading" class="faq-section__heading">{heading}</h2>

    {items.length === 0 ? (
      <p class="faq-section__empty">Keine FAQ-Einträge vorhanden.</p>
    ) : (
      <div class="faq-grid">

        <!-- Linke Spalte -->
        <dl class="faq-list">
          {leftItems.map(item => (
            <details class="faq-item" name="faq-left">
              <summary class="faq-item__question">
                <span>{item.question}</span>
                <svg class="faq-item__icon" viewBox="0 0 24 24" width="20" height="20"
                     aria-hidden="true" focusable="false">
                  <polyline points="6 9 12 15 18 9" fill="none" stroke="currentColor"
                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="faq-item__answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </dl>

        <!-- Rechte Spalte -->
        <dl class="faq-list">
          {rightItems.map(item => (
            <details class="faq-item" name="faq-right">
              <summary class="faq-item__question">
                <span>{item.question}</span>
                <svg class="faq-item__icon" viewBox="0 0 24 24" width="20" height="20"
                     aria-hidden="true" focusable="false">
                  <polyline points="6 9 12 15 18 9" fill="none" stroke="currentColor"
                    stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="faq-item__answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </dl>

      </div>
    )}

  </div>
</section>

<style>
  /* ── Section ──────────────────────────────────────── */
  .faq-section {
    padding-block: var(--space-16) var(--space-24);
  }

  .faq-section--page    { background: var(--color-bg-page);    }
  .faq-section--subtle  { background: var(--color-bg-subtle);  }
  .faq-section--surface { background: var(--color-bg-surface); }

  /* ~80 % der Seitenbreite, zentriert */
  .faq-section__inner {
    width:          80%;
    max-width:      var(--container-max);
    margin-inline:  auto;
    padding-inline: var(--container-padding);
    display:        flex;
    flex-direction: column;
    gap:            var(--space-8);
  }

  .faq-section__heading {
    text-align: center;
    color:      var(--color-text-heading);
  }

  .faq-section__empty {
    color:      var(--color-text-muted);
    text-align: center;
  }

  /* ── Zweispaltiges Grid ───────────────────────────── */
  .faq-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   0 var(--space-12);   /* Spaltenabstand */
    align-items:           start;
  }

  /* Unter 760 px: einspaltig */
  @media (max-width: 760px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-section__inner {
      width: 92%;
    }
  }

  /* ── Fragen-Liste ─────────────────────────────────── */
  .faq-list {
    display:        flex;
    flex-direction: column;
    margin:         0;
    padding:        0;
  }

  /* ── Einzelnes FAQ-Element ────────────────────────── */
  .faq-item {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .faq-item:first-of-type {
    border-top: 1px solid var(--color-border-subtle);
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
  }

  /* ── Frage (summary) ──────────────────────────────── */
  .faq-item__question {
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    gap:             var(--space-4);
    padding:         var(--space-5) 0;
    cursor:          pointer;
    list-style:      none;
    color:           var(--color-text-heading);
    font-family:     var(--font-display);
    font-weight:     var(--fw-semibold);
    font-size:       var(--fs-body);
    line-height:     1.4;
    transition:      color var(--transition-fast);
    user-select:     none;
  }

  .faq-item__question::-webkit-details-marker { display: none; }
  .faq-item__question::marker                 { display: none; }

  .faq-item__question:hover      { color: var(--color-brand-blue); }
  .faq-item[open] .faq-item__question { color: var(--color-brand-blue); }

  /* ── Pfeil-Icon ───────────────────────────────────── */
  .faq-item__icon {
    flex-shrink: 0;
    color:       var(--color-brand-blue);
    transition:  transform var(--transition-base);
  }

  /* ── Antwort ──────────────────────────────────────── */
  .faq-item__answer {
    padding-bottom: var(--space-5);
    padding-right:  var(--space-6);
  }

  .faq-item__answer p {
    font-size:   var(--fs-body);
    color:       var(--color-text-body);
    line-height: var(--lh-body);
    margin:      0;
  }

  .faq-item__question:focus-visible {
    outline:       none;
    box-shadow:    var(--focus-ring);
    border-radius: var(--radius-sm);
  }
</style>
