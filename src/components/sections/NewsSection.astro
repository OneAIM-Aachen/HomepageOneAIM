---
// src/components/sections/NewsSection.astro
//
// News-Band am Ende der Startseite – gleiche Kartenoptik wie das
// "News from {City}"-Band der Standortseiten (CityBlueprint), aber
// standortübergreifend: die neuesten Beiträge aus newsData.ts.

import { getSortedNews } from "../../data/newsData";

// Alle Beiträge, neueste zuerst – sichtbar sind zwei, die Pfeile blättern.
const news = getSortedNews();

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});
---

<section class="lnews" aria-labelledby="lnews-heading">
  <div class="container">
    <div class="lnews__panel">
      <div class="lnews__head">
        <h2 id="lnews-heading">News from OneAIM</h2>
        <div class="lnews__head-right">
          <a class="lnews__more" href="/news">All news →</a>
          <button type="button" class="lnews__nav-btn" data-lnews-nav="prev" aria-label="Scroll news back">←</button>
          <button type="button" class="lnews__nav-btn" data-lnews-nav="next" aria-label="Scroll news forward">→</button>
        </div>
      </div>
      <div class="lnews__grid" data-lnews-row tabindex="0">
        {news.map(n => (
          <a class="lnews__card" href={`/news/${n.id}`}>
            <span class="lnews__thumb">
              {n.image
                ? <img src={n.image} alt="" loading="lazy" decoding="async" />
                : <span class="lnews__slot">Photo</span>}
            </span>
            <span class="lnews__body">
              <span class="lnews__title">{n.title}</span>
              <span class="lnews__date">{dateFmt.format(new Date(n.date))}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .lnews {
    background:    var(--color-bg-surface);
    padding-block: var(--space-6) var(--space-24);
  }

  .lnews__panel {
    background:     var(--color-bg-surface);
    border-radius:  var(--radius-lg);
    box-shadow:     0 8px 32px rgba(35, 42, 207, 0.08);
    padding:        clamp(var(--space-8), 4vw, 56px) clamp(var(--space-6), 5vw, 64px);
    display:        flex;
    flex-direction: column;
    gap:            var(--space-6);
  }

  .lnews__head {
    display:         flex;
    align-items:     flex-end;
    justify-content: space-between;
    gap:             var(--space-8);
    flex-wrap:       wrap;
  }

  .lnews__head h2 { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem); }

  .lnews__more { font-size: 14px; font-weight: var(--fw-bold); color: var(--color-brand-blue); }

  .lnews__grid {
    display:          flex;
    gap:              var(--space-6);
    overflow-x:       auto;
    scroll-behavior:  smooth;
    scrollbar-width:  none;
    scroll-snap-type: x proximity;
  }

  .lnews__grid::-webkit-scrollbar { display: none; }

  /* Zwei Karten sichtbar, die Pfeile blättern durch den Rest */
  .lnews__card {
    flex:              0 0 calc(50% - var(--space-6) / 2);
    scroll-snap-align: start;
  }

  @media (max-width: 760px) {
    .lnews__card { flex-basis: 100%; }
  }

  .lnews__head-right { display: flex; align-items: center; gap: 12px; }

  /* Mobil bricht die Kopfzeile um – dann Link links, Pfeile rechts */
  @media (max-width: 760px) {
    .lnews__head-right {
      width:           100%;
      justify-content: space-between;
    }
    .lnews__nav-btn:first-of-type { margin-left: auto; }
  }

  .lnews__nav-btn {
    width:           40px;
    height:          40px;
    border-radius:   50%;
    border:          1px solid #DEE3ED;
    background:      var(--color-bg-surface);
    color:           var(--color-text-heading);
    font-size:       16px;
    font-weight:     800;
    display:         flex;
    align-items:     center;
    justify-content: center;
    cursor:          pointer;
    transition:      border-color var(--transition-fast), color var(--transition-fast);
  }

  .lnews__nav-btn:hover { border-color: var(--color-brand-blue); color: var(--color-brand-blue); }

  .lnews__card {
    display:               grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap:                   20px;
    align-items:           center;
    padding:               20px 24px;
    border:                1px solid var(--color-border-subtle);
    border-radius:         var(--radius-md);
    text-decoration:       none;
    transition:            box-shadow var(--transition-base);
  }

  .lnews__card:hover { box-shadow: 0 8px 24px rgba(35, 42, 207, 0.12); text-decoration: none; }

  .lnews__thumb { display: block; height: 80px; border-radius: 10px; overflow: hidden; }
  .lnews__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .lnews__body  { display: flex; flex-direction: column; gap: 4px; }
  .lnews__title { font-family: var(--font-display); font-weight: var(--fw-bold); font-size: 16px; color: var(--color-text-heading); }
  .lnews__date  { font-size: 13px; color: var(--color-text-muted); }

  .lnews__slot {
    display:         flex;
    align-items:     center;
    justify-content: center;
    width:           100%;
    height:          100%;
    border:          2px dashed #C4CBD9;
    border-radius:   10px;
    font-size:       12px;
    font-weight:     var(--fw-bold);
    color:           #98A1B4;
  }

  @media (max-width: 560px) {
    .lnews__card  { grid-template-columns: minmax(0, 1fr); }
    .lnews__thumb { height: 140px; }
  }
</style>

<script is:inline>
  (function () {
    // Das Script steht im DOM NACH der Section – closest() griffe ins Leere.
    var root = document.querySelector(".lnews");
    if (!root) return;
    var row = root.querySelector("[data-lnews-row]");
    if (!row) return;
    [].slice.call(root.querySelectorAll("[data-lnews-nav]")).forEach(function (btn) {
      btn.addEventListener("click", function () {
        var card = row.querySelector(".lnews__card");
        var step = card ? card.offsetWidth + 24 : row.clientWidth / 2;
        var dir = btn.getAttribute("data-lnews-nav") === "next" ? 1 : -1;
        row.scrollBy({ left: dir * step, behavior: "smooth" });
      });
    });
  })();
</script>
