---
// src/components/sections/MapHero.astro
// Homepage hero: minimalist DACH map (fine dot-fill Germany, grey country
// outlines) with pinging, clickable pins on Aachen, Frankfurt and Munich.
// Geometry: world-atlas TopoJSON via d3-geo — no hand-drawn borders.
import Button from "../ui/Button.astro";
import { partners } from "../../data/partners";
import { cities } from "../../data/cityData";

// Pins on the map come from the location database: a new entry
// in cityData.ts automatically appears as a pin. The drawing script below
// is is:inline (no import possible), so the data travels as a
// data attribute on the map element.
const mapCities = cities.map(city => ({
  name: city.displayName,
  sub:  city.uniShort,
  href: `/${city.slug}`,
  lon:  city.coords.lon,
  lat:  city.coords.lat,
}));

// Derive the partner count from partners.ts, rounded down to full tens:
// 29 entries → "20+", from the 30th entry automatically "30+".
// Partners AND sponsors are counted, i.e. the whole list.
// Below 10 entries "0+" would be nonsense – then show the exact number.
const partnerCount = partners.length;
const partnerStat =
  partnerCount < 10 ? String(partnerCount) : `${Math.floor(partnerCount / 10) * 10}+`;
---

<section class="map-hero" aria-label="Hero-Bereich">
  <div class="container map-hero__inner">
    <div class="map-hero__copy">
      <p class="map-hero__overline">Advancing Technology in Healthcare</p>
      <h1 class="map-hero__headline">AIM high with us</h1>
      <p class="map-hero__lead">
        Europe's biggest student-led interdisciplinary initiative in MedTech.
        We equip the next generation with the network and skills to shape the
        future of healthcare!
      </p>
      <div class="map-hero__actions">
        <Button href="#programs" variant="primary">Our Programs</Button>
        <Button href="/news" variant="secondary">News</Button>
      </div>
      <div class="map-hero__stats">
        <div><span class="map-hero__stat-n">{cities.length}</span><span class="map-hero__stat-l">Cities</span></div>
        <div><span class="map-hero__stat-n">500+</span><span class="map-hero__stat-l">Students in our network</span></div>
        <div><span class="map-hero__stat-n">{partnerStat}</span><span class="map-hero__stat-l">Partnerships</span></div>
      </div>
    </div>
    <div class="map-hero__map" id="dach-map" role="img"
         data-cities={JSON.stringify(mapCities)}
         aria-label={`Map of the DACH region with OneAIM chapters in ${mapCities.map(c => c.name).join(", ")}`}></div>
  </div>
</section>

<script is:inline src="https://unpkg.com/d3@7.9.0/dist/d3.min.js" integrity="sha384-CjloA8y00+1SDAUkjs099PVfnY2KmDC2BZnws9kh8D/lX1s46w6EPhpXdqMfjK6i" crossorigin="anonymous"></script>
<script is:inline src="https://unpkg.com/topojson-client@3.1.0/dist/topojson-client.min.js" integrity="sha384-Ukv1p/xTma6P4/2bY5KzWBw+ydSpXmhCMtyciIQVDJ1RmOxtCYNMF1uXT9T63H67" crossorigin="anonymous"></script>
<script is:inline>
(function () {
  var el = document.getElementById("dach-map");
  if (!el || el.dataset.drawn) return;
  el.dataset.drawn = "1";

  // Pins from the location database (via data attribute, see frontmatter).
  var CITIES = JSON.parse(el.dataset.cities || "[]");
  var DACH = { "276": 1, "040": 1, "756": 1 }; // DE, AT, CH
  var pad3 = function (id) { return String(id).padStart(3, "0"); };

  fetch("https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json")
    .then(function (r) { return r.json(); })
    .then(function (topo) {
      var all = topojson.feature(topo, topo.objects.countries).features;
      var dach = all.filter(function (f) { return DACH[pad3(f.id)]; });
      var germany = all.filter(function (f) { return pad3(f.id) === "276"; });

      var w = el.clientWidth, h = el.clientHeight, pad = 26;
      var svg = d3.select(el).append("svg")
        .attr("viewBox", "0 0 " + w + " " + h)
        .attr("width", "100%").attr("height", "100%");
      // On narrow screens the map stands alone: fit the projection to
      // Germany itself so it sits centered instead of drifting left when
      // the whole DACH bounding box is squeezed into a portrait container.
      var narrow = window.matchMedia("(max-width: 900px)").matches;
      var proj = d3.geoMercator().fitExtent(
        [[pad, pad], [w - pad, h - pad]],
        { type: "FeatureCollection", features: narrow ? germany : dach }
      );
      var path = d3.geoPath(proj);

      // All country borders as light grey outlines
      svg.append("g").selectAll("path").data(all).join("path")
        .attr("d", path).attr("fill", "none")
        .attr("stroke", "#dfe2e9").attr("stroke-width", 1.1)
        .attr("stroke-linejoin", "round");

      // Fine dot-fill for Germany
      var step = 6, dots = [];
      for (var x = 0; x < w; x += step)
        for (var y = 0; y < h; y += step) {
          var ll = proj.invert([x, y]);
          if (germany.some(function (f) { return d3.geoContains(f, ll); })) dots.push([x, y]);
        }
      svg.append("g").selectAll("circle").data(dots).join("circle")
        .attr("cx", function (d) { return d[0]; })
        .attr("cy", function (d) { return d[1]; })
        .attr("r", step * 0.22).attr("fill", "#c3d3fb");

      // Pinging, clickable pins
      var pins = svg.append("g");
      CITIES.forEach(function (c, i) {
        var p = proj([c.lon, c.lat]);
        var a = pins.append("a").attr("href", c.href).attr("class", "map-hero-pin")
          .attr("aria-label", "OneAIM " + c.name + ": view chapter");
        var g = a.append("g").attr("transform", "translate(" + p[0] + "," + p[1] + ")");
        ["ping1", "ping2"].forEach(function (cls, j) {
          g.append("circle").attr("class", "map-hero-" + cls).attr("r", 6)
            .attr("fill", "none").attr("stroke", "#8D2DF1")
            .attr("stroke-width", j ? 1.4 : 2)
            // Ring is scaled up via transform; without this the stroke
            // would scale along and the ring would get thicker and thicker.
            .attr("vector-effect", "non-scaling-stroke")
            .style("animation-delay", (i * 0.35 + j * 0.55) + "s");
        });
        g.append("circle").attr("class", "map-hero-core").attr("r", 7)
          .attr("fill", "#8D2DF1").attr("stroke", "#fff").attr("stroke-width", 2.5);
        g.append("text").attr("class", "map-hero-citylbl")
          .attr("x", 16).attr("y", 9).text(c.name);
        g.append("text").attr("class", "map-hero-hoverlbl")
          .attr("x", 16).attr("y", 26).text("View chapter →");
      });
    });
})();
</script>

<style is:global>
  .map-hero {
    background: var(--color-bg-surface);
    /* Tighter at the bottom than at the top: the partner section below
       brings its own spacing, otherwise both add up to a gap. */
    padding-block: var(--space-16) var(--space-8);
  }
  .map-hero__inner {
    display: grid;
    grid-template-columns: minmax(320px, 460px) 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .map-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .map-hero__overline {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-purple);
  }
  .map-hero__headline {
    font-size: var(--fs-display);
    color: var(--color-text-heading);
  }
  .map-hero__lead {
    font-size: var(--fs-body-lg);
    max-width: 46ch;
  }
  .map-hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .map-hero__stats {
    display: flex;
    gap: var(--space-8);
    margin-top: var(--space-2);
  }
  .map-hero__stats > div { display: flex; flex-direction: column; gap: 2px; }
  .map-hero__stat-n {
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    color: var(--color-brand-blue);
    line-height: var(--lh-heading);
  }
  .map-hero__stat-l { font-size: var(--fs-small); font-weight: var(--fw-semibold); }
  .map-hero__map { height: 560px; }

  /* SVG pin styles (global: elements are created by JS) */
  .map-hero-ping1, .map-hero-ping2 {
    /* Scale transform instead of animating the SVG r attribute:
       WebKit (iOS Safari) does not animate r via CSS, so the pings
       froze on phones. transform-box makes the circle scale in place. */
    transform-box:    fill-box;
    transform-origin: center;
    animation: map-hero-ping 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  @keyframes map-hero-ping {
    0% { transform: scale(1); opacity: 0.75; }
    80%, 100% { transform: scale(4.33); opacity: 0; }
  }
  .map-hero-pin { cursor: pointer; }
  .map-hero-core { transition: r 0.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .map-hero-pin:hover .map-hero-core { r: 10; }
  .map-hero-citylbl {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 14px;
    fill: #111;
  }
  .map-hero-pin:hover .map-hero-citylbl { fill: var(--color-accent-purple); }
  .map-hero-hoverlbl {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 11.5px;
    fill: var(--color-accent-purple);
    opacity: 0;
    transition: opacity 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .map-hero-pin:hover .map-hero-hoverlbl { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .map-hero-ping1, .map-hero-ping2 { animation: none; opacity: 0; }
  }
  @media (max-width: 900px) {
    .map-hero__inner { grid-template-columns: 1fr; }
    .map-hero__map { height: 420px; }
    /* The map shrinks along – larger labels keep the
       city names readable on small displays. */
    .map-hero-citylbl { font-size: 18px; }
  }
</style>
