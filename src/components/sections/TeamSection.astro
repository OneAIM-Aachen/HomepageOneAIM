---
// src/components/sections/TeamSection.astro
//
// ─────────────────────────────────────────────────────────────────────────────
// Verbindungsschicht zwischen team.ts und der generischen Carousel-Komponente.
//
// Was diese Komponente tut:
//   1. Nimmt TeamMember[] als Prop entgegen
//   2. Mappt sie auf CarouselItem[] (passt zum Carousel-Interface)
//   3. Rendert Carousel mit showLabels={true} (Karten-Modus)
//   4. Überschreibt Carousel-Styles für Team-Optik (runde Bilder,
//      volle Farbe, größerer Avatar) – isoliert über .team-carousel
//      damit das Sponsor-Carousel unverändert bleibt
//
// Was diese Komponente NICHT tut:
//   → Kein eigenes Carousel implementieren
//   → Keine direkte Verwendung von TeamCard.astro im Carousel
//      (Astro erlaubt keine dynamischen Komponenten-Props als Slot-Inhalte;
//      TeamCard.astro ist für den eigenständigen Einsatz gedacht)
// ─────────────────────────────────────────────────────────────────────────────

import Carousel, { type CarouselItem } from "../ui/Carousel.astro";
import type { TeamMember } from "../../data/team";

interface Props {
  members:    TeamMember[];
  heading?:   string;
  subtext?:   string;
  /** Hintergrundvariante der Section */
  background?: "page" | "subtle" | "surface";
}

const {
  members,
  heading    = "Our Team",
  subtext    = "The interdisciplinary team behind OneAIM",
  background = "subtle",
} = Astro.props;

// TeamMember → CarouselItem
// Das Mapping ist minimal: Carousel kennt nur das generische Interface.
const carouselItems: CarouselItem[] = members.map(m => ({
  id:       m.id,
  name:     m.name,
  image:    m.photo,
  imageAlt: m.photoAlt ?? `Profilfoto von ${m.name}`,
  meta:     m.role,
  href:     m.linkedin,
}));
---

<section
  class={`team-section team-section--${background}`}
  aria-labelledby="team-heading"
>
  <div class="container team-section__inner">

    <h2 id="team-heading" class="team-section__heading">{heading}</h2>

    {subtext && (
      <p class="team-section__sub">{subtext}</p>
    )}

    <!--
      Generische Carousel-Komponente – KEINE Änderung an Carousel.astro.
      Team-spezifische Optik wird ausschließlich über CSS im Wrapper
      .team-carousel gesteuert (Scope via :global()).
    -->
    <div class="team-carousel">
      <Carousel
        items={carouselItems}
        ariaLabel={`Team: ${heading}`}
        visibleDesktop={3}
        visibleTablet={2}
        visibleMobile={1}
        autoPlay={false}
        showLabels={true}
      />
    </div>

  </div>
</section>

<style>
  /* ── Section-Hintergrundvarianten ─────────────────────────── */
  .team-section { padding-block: var(--space-16) var(--space-24); }
  .team-section--page    { background: var(--color-bg-page);    }
  .team-section--subtle  { background: var(--color-bg-subtle);  }
  .team-section--surface { background: var(--color-bg-surface); }

  .team-section__inner {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-6);
  }

  .team-section__heading {
    text-align:  center;
    color:       var(--color-text-heading);
  }

  .team-section__sub {
    text-align:  center;
    color:       var(--color-text-muted);
    font-size:   var(--fs-body);
    max-width:   560px;
    margin:      0 auto;
  }

  /* ────────────────────────────────────────────────────────────
     TEAM-SPEZIFISCHE CAROUSEL-OVERRIDES
     Scope: .team-carousel – betrifft NUR diesen Carousel,
     NICHT den Sponsor-Carousel.
     ──────────────────────────────────────────────────────────── */

  /* Bild-Container: quadratisch, zentriert, mehr Raum für Avatar */
  .team-carousel :global(.carousel__img-wrap) {
    height:  160px;
    padding: var(--space-4) var(--space-4) 0;
    align-items: flex-end;  /* Avatar am unteren Rand des Containers */
  }

  /* Profilbild: kreisförmig, volle Sättigung (kein Graustufen-Filter) */
  .team-carousel :global(.carousel__img-wrap img) {
    width:          120px;
    height:         120px;
    max-height:     120px;
    border-radius:  var(--radius-pill);   /* 999px → Kreis */
    object-fit:     cover;
    filter:         none !important;       /* override grayscale aus Carousel */
    opacity:        1 !important;          /* immer voll sichtbar */
    box-shadow:     0 0 0 3px var(--color-brand-blue-light);
  }

  /* Karten-Innenabstand oben: etwas mehr Luft für Avatar */
  .team-carousel :global(.carousel__inner--card) {
    padding-top: var(--space-2);
  }

  /* Name: Heading-Größe, fett */
  .team-carousel :global(.carousel__name) {
    font-size:   var(--fs-body);
    font-weight: var(--fw-bold);
    color:       var(--color-text-heading);
  }

  /* Rolle: kleiner, gedämpft */
  .team-carousel :global(.carousel__meta) {
    font-size:   var(--fs-small);
    font-weight: var(--fw-medium);
    color:       var(--color-brand-blue);   /* dezent in Brand Blue */
  }

  /* Hover auf Team-Karten: sanfter Schatten */
  .team-carousel :global(.carousel__inner--card:hover) {
    box-shadow: 0 8px 28px rgba(0, 82, 233, 0.14);
  }
</style>
