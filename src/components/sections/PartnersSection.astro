---
// src/components/sections/PartnersSection.astro
//
// Verbindet partners.ts mit der generischen Carousel-Komponente.
// Neue Partner ergänzen: Bild nach public/images/partners/ legen
// und Eintrag in src/data/partners.ts hinzufügen.

import Carousel, { type CarouselItem } from "../ui/Carousel.astro";
import { partners } from "../../data/partners";

const items: CarouselItem[] = partners.map(p => ({
  id:       p.id,
  name:     p.name,
  image:    p.logo,
  imageAlt: p.logoAlt ?? `${p.name} Logo`,
  href:     p.website,
}));
---

<section class="partners-section" aria-labelledby="partners-heading">
  <div class="container partners-section__inner">

    <h2 id="partners-heading" class="partners-section__heading">
      Sponsors and partners we have collaborated with
    </h2>
    <p class="partners-section__sub">
      Als studentisch geführte Initiative freuen wir uns über jede Unterstützung,
      die unsere Mission einer kostenfreien Bildung im MedTech-Bereich trägt.
    </p>

    <!-- Wrapper für Logo-spezifische CSS-Overrides -->
    <div class="partners-carousel">
      <Carousel
        items={items}
        ariaLabel="Sponsoren und Kooperationspartner von OneAIM"
        visibleDesktop={4}
        visibleTablet={3}
        visibleMobile={2}
        autoPlay={true}
        autoPlayInterval={4500}
        showLabels={false}
      />
    </div>

  </div>
</section>

<style>
  .partners-section {
    background:   var(--color-bg-surface);
    padding-top:  12rem;
    padding-bottom: var(--space-24);
  }

  .partners-section__inner {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-6);
  }

  .partners-section__heading {
    text-align:  center;
    color:       var(--color-text-heading);
    font-size:   var(--fs-h2);
    font-weight: var(--fw-bold);
    max-width:   640px;
    margin:      0 auto;
  }

  .partners-section__sub {
    text-align: center;
    color:      var(--color-text-muted);
    font-size:  var(--fs-body);
    max-width:  560px;
    margin:     0 auto;
  }

  /* ── Logo-spezifische Carousel-Overrides ──────────────────────
     Erhöht die Logo-Höhe ohne andere Carousels (z. B. Team) zu
     beeinflussen. Scope: nur innerhalb .partners-carousel.      */

  /* Größeres Bild-Fenster für besser sichtbare Logos */
  .partners-carousel :global(.carousel__img-wrap) {
    height:  110px;
    padding: var(--space-4) var(--space-4);
  }

  /* Logos: volle Größe im Rahmen, kein Graustufen-Effekt */
  .partners-carousel :global(.carousel__img-wrap img) {
    max-height: 90px;
    filter:     grayscale(15%) opacity(0.85);
    transition: filter var(--transition-base);
  }

  .partners-carousel :global(.carousel__inner:hover .carousel__img-wrap img) {
    filter: grayscale(0%) opacity(1);
  }
</style>
