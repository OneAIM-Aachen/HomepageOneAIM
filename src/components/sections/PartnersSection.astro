---
// src/components/sections/PartnersSection.astro
//
// Endlos durchlaufendes Logo-Band ("Marquee") statt Karussell.
// Neue Partner ergänzen: Bild nach public/images/partners/ legen
// und Eintrag in src/data/partners.ts hinzufügen – hier ist nichts zu tun.
//
// Technik: Die Partnerliste wird zweimal gerendert und das Band um genau
// -50 % verschoben. Dadurch ist der Sprung am Ende der Animation exakt
// deckungsgleich mit dem Anfang → nahtlose Endlosschleife.
// Die zweite Kopie ist rein dekorativ (aria-hidden + tabindex="-1"),
// damit Screenreader und Tastaturnavigation jeden Partner nur einmal sehen.

// Nur die für die Startseite markierten Einträge (onLanding: true in
// partners.ts). Die vollständige Liste steht auf /partners.
import { landingPartners } from "../../data/partners";

// Zufällige Reihenfolge (Fisher-Yates), neu gemischt bei jedem Build –
// so wirkt das Band gemischt statt nach Datenbank-Reihenfolge sortiert.
// Nebenbedingung: Universitäten laufen nicht direkt hintereinander
// (inklusive Übergang am Schleifenende, das Band wiederholt sich nahtlos).
const UNIVERSITIES = new Set(["tum", "lmu", "rwth-aachen", "harvard"]);
const isUni = (p: (typeof landingPartners)[number]) => UNIVERSITIES.has(p.id);

function shuffled() {
  const arr = [...landingPartners];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

let partners = shuffled();
for (let tries = 0; tries < 1000; tries++) {
  const clash = partners.some((p, i) => isUni(p) && isUni(partners[(i + 1) % partners.length]));
  if (!clash) break;
  partners = shuffled();
}
---

<section class="partners-section" aria-labelledby="partners-heading">
  <div class="container">
    <h2 id="partners-heading" class="partners-section__label">
      <a href="/partners" class="partners-section__label-link">
        <span class="partners-section__swap">
          <span class="partners-section__swap-rest">Our partners &amp; sponsors include</span>
          <!-- Rein visueller Hover-Text: für Screenreader ausgeblendet,
               damit die Überschrift nicht doppelt vorgelesen wird. -->
          <span class="partners-section__swap-hover" aria-hidden="true">See all partners &amp; sponsors</span>
        </span>
      </a>
    </h2>
  </div>

  <div class="partners-marquee">
    <div class="partners-marquee__track">
      {[0, 1].map(copy => (
        <ul class="partners-marquee__set" aria-hidden={copy === 1 ? "true" : undefined}>
          {partners.map(p => (
            <li class="partners-marquee__item">
              {p.website ? (
                <a
                  href={p.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={copy === 1 ? -1 : undefined}
                >
                  <img
                    src={p.logo}
                    alt={p.logoAlt ?? `${p.name} Logo`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <img
                  src={p.logo}
                  alt={p.logoAlt ?? `${p.name} Logo`}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

</section>

<style>
  .partners-section {
    background:     var(--color-bg-surface);
    padding-top:    var(--space-8);
    padding-bottom: var(--space-8);

    /* ← Tempo der Schleife. Größer = langsamer.
       Die Dauer gilt für eine ganze Runde, nicht für eine feste
       Geschwindigkeit: Bei jedem neuen Partner wird das Band länger und
       damit schneller. Faustregel für gleichbleibendes Tempo:
       ca. 4s pro Logo im Band (8 Logos → ~32s).
       Maßgeblich ist die Zahl der Einträge mit onLanding: true,
       nicht die Gesamtzahl in partners.ts. */
    --marquee-duration: 32s;
  }

  /* Einzige Textzeile der Section – optisch das frühere Overline-Label. */
  .partners-section__label {
    text-align:     center;
    font-size:      13px;
    font-weight:    var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color:          var(--color-accent-purple);
    margin-bottom:  var(--space-12);
  }

  /* ── Laufband ─────────────────────────────────────────────────
     Volle Fensterbreite (nicht im .container), damit die Logos an
     beiden Rändern aus dem Bild laufen. Die Maske blendet sie dabei
     sanft aus, statt sie hart abzuschneiden.                      */
  .partners-marquee {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  .partners-marquee__track {
    display:     flex;
    width:       max-content;
    will-change: transform;
    animation:   partners-roll var(--marquee-duration) linear infinite;
  }

  /* Beim Überfahren anhalten, damit man ein Logo gezielt anklicken kann. */
  .partners-marquee:hover .partners-marquee__track,
  .partners-marquee:focus-within .partners-marquee__track {
    animation-play-state: paused;
  }

  .partners-marquee__set {
    display:     flex;
    align-items: center;
    flex-shrink: 0;
  }

  .partners-marquee__item {
    flex:            0 0 auto;
    width:           200px;
    height:          96px;
    display:         flex;
    align-items:     center;
    justify-content: center;
  }

  .partners-marquee__item a {
    display:         flex;
    align-items:     center;
    justify-content: center;
    width:           100%;
    height:          100%;
  }

  .partners-marquee__item img {
    max-height: 62px;
    max-width:  150px;
    width:      auto;
    object-fit: contain;
    /* Leicht zurückgenommen, damit das Band ruhig wirkt. */
    filter:     grayscale(15%) opacity(0.85);
    transition: filter var(--transition-base);
  }

  .partners-marquee__item:hover img {
    filter: grayscale(0%) opacity(1);
  }

  /* ── Überschrift als Link auf /partners ───────────────────────
     Kein eigener Button: die Überschrift selbst führt zur vollen
     Partnerseite. Der Pfeil erscheint beim Überfahren, damit die
     Zeile im Ruhezustand wie ein reines Label aussieht.          */
  .partners-section__label-link {
    position:        relative;
    display:         inline-block;
    color:           inherit;
    text-decoration: none;
    transition:      color var(--transition-fast);
  }

  /* Absolut positioniert: der Pfeil belegt keine Layoutbreite. Sonst
     stünde die Überschrift dauerhaft um seine halbe Breite links
     außerhalb der Mitte – und würde beim Hover zusätzlich springen. */
  .partners-section__label-link::after {
    content:     "→";
    position:    absolute;
    top:         50%;
    left:        100%;
    margin-left: var(--space-2);
    opacity:     0;
    transform:   translateY(-50%) translateX(-4px);
    transition:  opacity var(--transition-base), transform var(--transition-base);
  }

  .partners-section__label-link:hover,
  .partners-section__label-link:focus-visible {
    color: var(--color-brand-blue);
  }

  /* ── Text-Tausch beim Hover ───────────────────────────────────
     Beide Texte liegen im selben Grid-Feld übereinander. Dadurch ist
     der Container so breit wie der längere Text und die Zeile springt
     beim Wechsel nicht in der Breite.                             */
  .partners-section__swap {
    display: grid;
  }

  .partners-section__swap > span {
    grid-area:  1 / 1;
    transition: opacity var(--transition-base);
  }

  .partners-section__swap-hover { opacity: 0; }

  .partners-section__label-link:hover .partners-section__swap-rest,
  .partners-section__label-link:focus-visible .partners-section__swap-rest {
    opacity: 0;
  }

  .partners-section__label-link:hover .partners-section__swap-hover,
  .partners-section__label-link:focus-visible .partners-section__swap-hover {
    opacity: 1;
  }

  .partners-section__label-link:hover::after,
  .partners-section__label-link:focus-visible::after {
    opacity:   1;
    transform: translateY(-50%) translateX(0);
  }

  /* Touch-Geräte kennen kein Hover: dort ist der Pfeil dauerhaft
     sichtbar, sonst wäre der Link praktisch unauffindbar.        */
  @media (hover: none) {
    .partners-section__label-link::after {
      opacity:   1;
      transform: translateY(-50%) translateX(0);
    }
  }

  @keyframes partners-roll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Reduzierte Bewegung ──────────────────────────────────────
     Kein Lauf, keine Maske: die Logos werden zu einem statischen,
     umbrechenden Raster. Die dekorative zweite Kopie entfällt.
     !important schlägt die globale Reduced-Motion-Regel in
     global.css, die sonst nur die Dauer auf 0.001ms setzt und das
     Band dadurch am Endpunkt (-50 %) einfrieren würde.            */
  @media (prefers-reduced-motion: reduce) {
    .partners-marquee {
      mask-image:         none;
      -webkit-mask-image: none;
    }

    .partners-marquee__track {
      animation: none !important;
      width:     100%;
    }

    .partners-marquee__set {
      flex-wrap:       wrap;
      justify-content: center;
      width:           100%;
    }

    .partners-marquee__set[aria-hidden="true"] {
      display: none;
    }
  }
</style>
