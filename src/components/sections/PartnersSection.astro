---
// src/components/sections/PartnersSection.astro
//
// Endlessly running logo band ("marquee") instead of a carousel.
// Adding new partners: put the image into public/images/partners/
// and add an entry in src/data/partners.ts – nothing to do here.
//
// Technique: the partner list is rendered twice and the band shifted by
// exactly -50 %. This makes the jump at the end of the animation exactly
// congruent with the beginning → seamless endless loop.
// The second copy is purely decorative (aria-hidden + tabindex="-1"),
// so screen readers and keyboard navigation see each partner only once.

// Only the entries marked for the homepage (onLanding: true in
// partners.ts). The full list is on /partners.
import { landingPartners } from "../../data/partners";

// Random order (Fisher-Yates), reshuffled on every build –
// this makes the band look mixed instead of sorted by database order.
// Constraint: universities do not run directly one after another
// (including the transition at the loop end, the band repeats seamlessly).
const UNIVERSITIES = new Set(["tum", "lmu", "rwth-aachen", "harvard"]);
const isUni = (p: (typeof landingPartners)[number]) => UNIVERSITIES.has(p.id);

function shuffled() {
  const arr = [...landingPartners];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

let partners = shuffled();
for (let tries = 0; tries < 1000; tries++) {
  const clash = partners.some((p, i) => isUni(p) && isUni(partners[(i + 1) % partners.length]));
  if (!clash) break;
  partners = shuffled();
}
---

<section class="partners-section" aria-labelledby="partners-heading">
  <div class="container">
    <h2 id="partners-heading" class="partners-section__label">
      <a href="/partners" class="partners-section__label-link">
        <span class="partners-section__swap">
          <span class="partners-section__swap-rest">Our partners &amp; sponsors include</span>
          <!-- Purely visual hover text: hidden from screen readers,
               so the heading is not read out twice. -->
          <span class="partners-section__swap-hover" aria-hidden="true">See all partners &amp; sponsors</span>
        </span>
      </a>
    </h2>
  </div>

  <div class="partners-marquee">
    <div class="partners-marquee__track">
      {[0, 1].map(copy => (
        <ul class="partners-marquee__set" aria-hidden={copy === 1 ? "true" : undefined}>
          {partners.map(p => (
            <li class="partners-marquee__item">
              {p.website ? (
                <a
                  href={p.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={copy === 1 ? -1 : undefined}
                >
                  <img
                    src={p.logo}
                    alt={p.logoAlt ?? `${p.name} Logo`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <img
                  src={p.logo}
                  alt={p.logoAlt ?? `${p.name} Logo`}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

</section>

<style>
  .partners-section {
    background:     var(--color-bg-surface);
    padding-top:    var(--space-8);
    padding-bottom: var(--space-8);

    /* ← Pace of the loop. Larger = slower.
       The duration applies to one full round, not to a fixed
       speed: with every new partner the band gets longer and
       thus faster. Rule of thumb for a constant pace:
       ca. 4s per logo in the band (8 logos → ~32s).
       What matters is the number of entries with onLanding: true,
       not the total number in partners.ts. */
    --marquee-duration: 32s;
  }

  /* The only text line of the section – visually the former overline label. */
  .partners-section__label {
    text-align:     center;
    font-size:      13px;
    font-weight:    var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color:          var(--color-accent-purple);
    margin-bottom:  var(--space-12);
  }

  /* ── Marquee ──────────────────────────────────────────────────
     Full window width (not in the .container), so the logos run
     out of view at both edges. The mask fades them out
     gently instead of cutting them off hard.                     */
  .partners-marquee {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }

  .partners-marquee__track {
    display:     flex;
    width:       max-content;
    will-change: transform;
    animation:   partners-roll var(--marquee-duration) linear infinite;
  }

  /* Pause on hover, so a logo can be clicked deliberately. */
  .partners-marquee:hover .partners-marquee__track,
  .partners-marquee:focus-within .partners-marquee__track {
    animation-play-state: paused;
  }

  .partners-marquee__set {
    display:     flex;
    align-items: center;
    flex-shrink: 0;
  }

  .partners-marquee__item {
    flex:            0 0 auto;
    width:           200px;
    height:          96px;
    display:         flex;
    align-items:     center;
    justify-content: center;
  }

  .partners-marquee__item a {
    display:         flex;
    align-items:     center;
    justify-content: center;
    width:           100%;
    height:          100%;
  }

  .partners-marquee__item img {
    max-height: 62px;
    max-width:  150px;
    width:      auto;
    object-fit: contain;
    /* Slightly toned down, so the band looks calm. */
    filter:     grayscale(15%) opacity(0.85);
    transition: filter var(--transition-base);
  }

  .partners-marquee__item:hover img {
    filter: grayscale(0%) opacity(1);
  }

  /* ── Heading as a link to /partners ───────────────────────────
     No separate button: the heading itself leads to the full
     partner page. The arrow appears on hover, so the
     line looks like a pure label in its resting state.           */
  .partners-section__label-link {
    position:        relative;
    display:         inline-block;
    color:           inherit;
    text-decoration: none;
    transition:      color var(--transition-fast);
  }

  /* Absolutely positioned: the arrow takes up no layout width. Otherwise
     the heading would permanently sit half its width to the left
     of center – and would additionally jump on hover. */
  .partners-section__label-link::after {
    content:     "→";
    position:    absolute;
    top:         50%;
    left:        100%;
    margin-left: var(--space-2);
    opacity:     0;
    transform:   translateY(-50%) translateX(-4px);
    transition:  opacity var(--transition-base), transform var(--transition-base);
  }

  .partners-section__label-link:hover,
  .partners-section__label-link:focus-visible {
    color: var(--color-brand-blue);
  }

  /* ── Text swap on hover ───────────────────────────────────────
     Both texts sit in the same grid cell on top of each other. This
     makes the container as wide as the longer text and the line does
     not jump in width when switching.                             */
  .partners-section__swap {
    display: grid;
  }

  .partners-section__swap > span {
    grid-area:  1 / 1;
    transition: opacity var(--transition-base);
  }

  .partners-section__swap-hover { opacity: 0; }

  .partners-section__label-link:hover .partners-section__swap-rest,
  .partners-section__label-link:focus-visible .partners-section__swap-rest {
    opacity: 0;
  }

  .partners-section__label-link:hover .partners-section__swap-hover,
  .partners-section__label-link:focus-visible .partners-section__swap-hover {
    opacity: 1;
  }

  .partners-section__label-link:hover::after,
  .partners-section__label-link:focus-visible::after {
    opacity:   1;
    transform: translateY(-50%) translateX(0);
  }

  /* Touch devices know no hover: there the arrow is permanently
     visible, otherwise the link would be practically undiscoverable. */
  @media (hover: none) {
    .partners-section__label-link::after {
      opacity:   1;
      transform: translateY(-50%) translateX(0);
    }
  }

  @keyframes partners-roll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Deliberately no prefers-reduced-motion fallback: the band should
     roll in every browser. The !important guards against the global
     reduced-motion rule in global.css, which would otherwise set the
     duration to 0.001ms and freeze the band at its end point (-50 %). */
  .partners-marquee__track {
    animation-duration:        var(--marquee-duration) !important;
    animation-iteration-count: infinite                !important;
  }
</style>
