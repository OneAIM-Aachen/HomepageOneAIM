---
// src/components/sections/JoinSection.astro
// Abschluss-Banner der Startseite ("Sounds interesting?").
// Umsetzung von Entwurf 9A aus dem Claude-Design-Projekt
// ("What is OneAIM Options.dc.html", Abschnitt 9A):
// Verlaufsfläche mit zwei Glas-Karten – links Studierende, rechts Partner.
//
// LINKZIELE: "Apply for a program" springt zur Programmübersicht der
// Startseite (#programs), die anderen Buttons zur Kontaktseite. Bei
// Bedarf per Prop austauschbar – die Bewerbungslinks je Stadt und
// Programm stehen in src/data/applications.ts.

interface Props {
  applyHref?: string;
  memberHref?: string;
  partnerHref?: string;
}

const {
  applyHref   = "/#programs",
  memberHref  = "/contact",
  partnerHref = "/contact",
} = Astro.props as Props;
---

<section class="join" aria-labelledby="join-heading">
  <div class="container">
    <div class="join__panel">
      <div class="join__banner">

        <div class="join__head">
          <h2 id="join-heading" class="join__title">Sounds interesting?</h2>
          <p class="join__lead">
            Whether you're a student or a potential partner, here's your way into OneAIM.
          </p>
        </div>

        <div class="join__grid">
          <div class="join__card">
            <p class="join__label">For students</p>
            <p class="join__text">
              Join one of our programs as a participant, or help run OneAIM as part of the team.
            </p>
            <div class="join__actions">
              <a class="join__btn" href={applyHref}>Apply for a program →</a>
              <a class="join__btn join__btn--ghost" href={memberHref}>Join the team →</a>
            </div>
          </div>

          <div class="join__card">
            <p class="join__label">For partners</p>
            <p class="join__text">
              Work with us as a sponsor, host or speaker. Let's talk.
            </p>
            <div class="join__actions join__actions--bottom">
              <a class="join__btn" href={partnerHref}>Contact us →</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .join {
    background:    var(--color-bg-surface);
    padding-block: var(--space-6) var(--space-6);
  }

  .join__panel {
    background:    var(--color-bg-surface);
    border-radius: var(--radius-lg);
    box-shadow:    0 8px 32px rgba(35, 42, 207, 0.08);
    padding:       clamp(var(--space-6), 4vw, 64px);
  }

  .join__banner {
    background:     linear-gradient(135deg, var(--color-brand-blue), var(--color-accent-purple));
    border-radius:  28px;
    padding:        clamp(var(--space-12), 6vw, 80px) clamp(var(--space-6), 4vw, 64px);
    display:        flex;
    flex-direction: column;
    gap:            clamp(var(--space-8), 3vw, 44px);
    align-items:    center;
    text-align:     center;
  }

  .join__head {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
    align-items:    center;
  }

  .join__title {
    font-size:   clamp(2rem, 1.3rem + 2.8vw, 3rem);
    line-height: 1.08;
    color:       var(--color-text-on-dark);
  }

  .join__lead {
    font-size:   var(--fs-body-lg);
    line-height: 1.7;
    color:       rgba(255, 255, 255, 0.85);
    max-width:   600px;
  }

  /* minmax(0, …) statt 1fr: sonst kann die Spalte nicht schmaler werden
     als ihr Inhalt (die Buttons stehen auf white-space: nowrap) und die
     Karten laufen auf schmalen Displays aus dem Raster heraus. */
  .join__grid {
    display:               grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap:                   20px;
    width:                 100%;
  }

  /* Glaskarten auf dem Verlauf: leicht aufgehellt statt eingefärbt,
     damit der Farbverlauf darunter sichtbar bleibt. */
  .join__card {
    display:                 flex;
    flex-direction:          column;
    gap:                     18px;
    align-items:             flex-start;
    text-align:              left;
    background:              rgba(255, 255, 255, 0.12);
    backdrop-filter:         blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border:                  1px solid rgba(255, 255, 255, 0.25);
    border-radius:           var(--radius-lg);
    padding:                 36px 40px;
  }

  .join__label {
    font-size:      12px;
    font-weight:    800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--color-brand-blue-light);
  }

  .join__text {
    font-size:   15px;
    line-height: 1.65;
    color:       rgba(255, 255, 255, 0.85);
  }

  .join__actions {
    display:   flex;
    gap:       12px;
    flex-wrap: wrap;
  }

  /* Schiebt die Buttons der zweiten Karte nach unten, damit beide
     Karten trotz unterschiedlich langer Texte gleich abschließen. */
  .join__actions--bottom { margin-top: auto; }

  .join__btn {
    white-space:     nowrap;
    font-family:     var(--font-display);
    font-size:       14px;
    font-weight:     var(--fw-bold);
    color:           var(--color-brand-blue);
    background:      var(--color-bg-surface);
    border:          2px solid transparent;
    border-radius:   var(--radius-pill);
    padding:         9px 26px;
    text-decoration: none;
    transition:      background var(--transition-fast), border-color var(--transition-fast);
  }

  .join__btn:hover {
    background:      var(--color-brand-blue-light);
    text-decoration: none;
  }

  .join__btn--ghost {
    color:        var(--color-text-on-dark);
    background:   transparent;
    border-color: rgba(255, 255, 255, 0.6);
  }

  .join__btn--ghost:hover {
    background:   rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  .join__btn:focus-visible {
    outline:    none;
    box-shadow: var(--focus-ring-on-dark);
  }

  /* Ab hier untereinander statt nebeneinander. */
  @media (max-width: 820px) {
    .join__grid            { grid-template-columns: minmax(0, 1fr); }
    .join__card            { padding: var(--space-8); }
    .join__actions--bottom { margin-top: 0; }
  }

  /* Schmale Displays: Karten enger, Buttons dürfen umbrechen und füllen
     die Kartenbreite – nebeneinander passen sie hier nicht mehr. */
  @media (max-width: 560px) {
    .join__banner { padding-inline: var(--space-5, 20px); }

    .join__card {
      padding: var(--space-6);
      gap:     var(--space-4);
    }

    .join__actions { width: 100%; }

    .join__btn {
      flex:        1 1 100%;
      white-space: normal;
      text-align:  center;
      padding:     11px var(--space-4);
    }
  }
</style>
