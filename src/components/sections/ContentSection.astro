---
// src/components/sections/ContentSection.astro
// Wiederverwendbares Pattern für Text-Sections mit optional hervorgehobenem
// Titel-Teil und optionalem Bild (vgl. "Introduction"-Bereich der Homepage,
// nutzbar auch auf anderen Seiten ohne Strukturänderung).

interface Props {
  heading: string;
  headingAccent?: string;
  background?: "page" | "subtle" | "surface";
  imageAlt?: string;
}

const { heading, headingAccent, background = "page", imageAlt } = Astro.props;
---

<section class={`content-section content-section--${background}`}>
  <div class="container content-section__inner">
    <h2 class="content-section__heading">
      {heading}
      {headingAccent && <span class="content-section__heading-accent"> {headingAccent}</span>}
    </h2>

    <div class="content-section__body">
      <slot />
    </div>

    {
      Astro.slots.has("media") && (
        <div class="content-section__media">
          <slot name="media" />
          {imageAlt && <span class="visually-hidden">{imageAlt}</span>}
        </div>
      )
    }
  </div>
</section>

<style>
  .content-section {
    padding-block: var(--space-24);
  }

  .content-section--page {
    background: var(--color-bg-page);
  }

  .content-section--subtle {
    background: var(--color-bg-subtle);
  }

  .content-section--surface {
    background: var(--color-bg-surface);
  }

  .content-section__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
    max-width: 860px;
  }

  .content-section__heading {
    color: var(--color-text-heading);
  }

  .content-section__heading-accent {
    color: var(--color-brand-blue);
  }

  .content-section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--fs-body-lg);
    color: var(--color-text-body);
  }

  .content-section__media {
    width: 100%;
    max-width: 640px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .content-section__media :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
