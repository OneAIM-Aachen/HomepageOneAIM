---
// src/components/ApplicationCard.astro
//
// THE standard application card – same design as the card in the top-right
// corner of the city-page heroes (CityBlueprint): status dot, title,
// data rows, button. Used in the "Apply in your city" grids of the
// program pages; the data comes from applications.ts.

import type { CitySlug } from "../data/cityData";
import {
  getApplicationFor,
  getDeadlineLabel,
  getFeaturedApplication,
  getProgramName,
  getStatus,
  getTermLabel,
} from "../data/applications";

interface Props {
  city: CitySlug;
  /** Display name, e.g. "Munich" – used for the button text */
  cityName: string;
  /**
   * Program slug from programs.ts, e.g. "aim-connect".
   * Omit it to use the city's featured round (city-page hero).
   */
  program?: string;
  /** Button verb while a round is open (default: "Apply" → "Apply here") */
  ctaVerb?: string;
  /** "hero" = strong shadow for the card sitting on the hero photo */
  variant?: "hero";
  /** true = show no button in the empty state (no round) */
  hideEmptyCta?: boolean;
  /**
   * true = while the round is open, the button leads straight to the
   * application form (applyUrl, new tab) and the card shows
   * "Application open until <date>" above it instead of the date rows.
   * Used on the AIM Innovate page.
   */
  directApply?: boolean;
}

const { city, cityName, program, ctaVerb = "Apply", variant, hideEmptyCta = false, directApply = false } = Astro.props as Props;

// Long date with ordinal, e.g. "1st November 2026" (for directApply)
const ordinal = (n: number) =>
  n + (n % 100 >= 11 && n % 100 <= 13 ? "th" : ({ 1: "st", 2: "nd", 3: "rd" } as Record<number, string>)[n % 10] ?? "th");
const longDate = (iso: string) => {
  const d = new Date(`${iso}T00:00:00`);
  return `${ordinal(d.getDate())} ${new Intl.DateTimeFormat("en-GB", { month: "long" }).format(d)} ${d.getFullYear()}`;
};

// Short form without the year ("1 Sep") – the semester is in the card
// title; en-GB abbreviates September as "Sept", so normalize to 3 letters.
const shortDate = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short" });
const dateFmt = { format: (x: Date) => shortDate.format(x).replace("Sept", "Sep") };

const app    = program ? getApplicationFor(city, program) : getFeaturedApplication(city);
const status = app ? getStatus(app) : undefined;
// Deep links into the city page's program panel: "More info" jumps to the
// semester timeline, "Apply here" to the apply button. When the card is
// already on that city's own page (hero), use only the hash – otherwise
// the path change (/munich vs. /munich/) forces a full reload.
const prog = program ?? app?.program;
const onOwnPage = Astro.url.pathname.replace(/\/$/, "") === `/${city}`;
const base = onOwnPage ? "" : `/${city}`;
const infoAnchor  = prog ? `${base}#${prog}-timeline` : "/contact";
const applyAnchor = prog ? `${base}#${prog}-apply`    : "/contact";

// Direct application: only while the round is open and a form link exists
const direct = Boolean(directApply && app && status === "open" && app.applyUrl);

// Open round with a deadline time ("12:00"): instead of the
// "Application deadline" row the card says "Application open until 6 November 12:00".
const untilLine = Boolean(app && status === "open" && app.deadline && app.deadlineTime);

// Where does "Apply here" lead?
//  • AIM Connect: always to the apply button in the city page's Connect tab.
//  • AIM Code on its own city page (hero card): to the "Apply now" box in the
//    city page's AIM Code tab (#aim-code-apply), which holds the form link.
//  • Otherwise straight to the form (e.g. the Munich hero card while the
//    AIM Innovate round is open, or the cards on the AIM Code page).
const toPanel = prog === "aim-connect" || (prog === "aim-code" && onOwnPage);
const external = Boolean(
  app && status === "open" && app.applyUrl && (direct || !toPanel)
);

const card = app
  ? {
      status,
      statusLabel: status === "open" ? "Applications open" : "Applications not yet open",
      // On the city page (hero) the city is redundant as the headline:
      // there the program is large and the city sits in the subline.
      title:       variant === "hero" ? getProgramName(app) : cityName,
      subtitle:    variant === "hero"
        ? `${cityName} · ${getTermLabel(app)}`
        : `${getProgramName(app)} · ${getTermLabel(app)}`,
      rows: direct ? [] : [
        ...(status !== "open"
          ? [{ label: "Applications open", value: dateFmt.format(new Date(app.opensAt)) }]
          : []),
        ...(untilLine ? [] : [{ label: "Application deadline", value: getDeadlineLabel(app) }]),
        ...(app.startsAt ? [{ label: "Program start", value: dateFmt.format(new Date(app.startsAt)) }] : []),
        ...(app.spots    ? [{ label: "Spots", value: String(app.spots) }] : []),
      ],
      note:     undefined,
      deadlineLine: direct && app.deadline
        ? `Application open until ${longDate(app.deadline)}${app.deadlineTime ? `, ${app.deadlineTime}` : ""}`
        : untilLine
          // non-breaking spaces: "6 November 12:00" never splits across lines
          ? `Application open until ${getDeadlineLabel(app).replace(/ /g, "\u00A0")}`
          : undefined,
      ctaLabel: direct ? "Apply now" : status === "open" ? `${ctaVerb} here` : "More info",
      ctaHref:  external ? app.applyUrl! : status === "open" ? applyAnchor : infoAnchor,
    }
  : {
      status: "upcoming" as const,
      statusLabel: "No open applications",
      title: variant === "hero" ? "New applications opening soon" : cityName,
      subtitle: variant === "hero" ? cityName : "New applications opening soon",
      rows: [],
      note: "New rounds are announced here and on Instagram as soon as the dates are set.",
      deadlineLine: undefined,
      ctaLabel: "Contact us",
      ctaHref: "/contact",
    };
---

<div class={`appc ${variant === "hero" ? "appc--hero" : ""}`}>
  <div class={`appc__status appc__status--${card.status}`}>
    <span class="appc__dot" aria-hidden="true"></span>
    <span>{card.statusLabel}</span>
  </div>
  <h3 class="appc__title">{card.title}</h3>
  {card.subtitle && <p class="appc__subtitle">{card.subtitle}</p>}
  {card.rows.length > 0 && (
    <dl class="appc__rows">
      {card.rows.map(r => (
        <div class="appc__row">
          <dt>{r.label}</dt>
          <dd>{r.value}</dd>
        </div>
      ))}
    </dl>
  )}
  {card.note && <p class="appc__note">{card.note}</p>}
  {card.deadlineLine && <p class="appc__deadline">{card.deadlineLine}</p>}
  {!(hideEmptyCta && !app) && (
    <a class="appc__btn" href={card.ctaHref}
      {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{card.ctaLabel}</a>
  )}
  <slot />
</div>

<style>
  /* Mirror of the hero card (CityBlueprint .bp__app), just with a softer
     shadow – on light surfaces the hero shadow feels too heavy. */
  .appc {
    display:        flex;
    flex-direction: column;
    gap:            14px;
    background:     var(--color-bg-surface);
    border-radius:  var(--radius-lg);
    box-shadow:     0 8px 24px rgba(35, 42, 207, 0.10);
    padding:        clamp(var(--space-6), 2.5vw, 36px);
  }

  .appc__status {
    display:        flex;
    align-items:    center;
    gap:            10px;
    font-size:      13px;
    font-weight:    800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .appc__dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

  .appc__status--open           { color: #1fbf75; }
  .appc__status--open .appc__dot { background: #1fbf75; box-shadow: 0 0 0 4px rgba(31, 191, 117, 0.2); }

  .appc__status--upcoming           { color: var(--color-text-muted); }
  .appc__status--upcoming .appc__dot { background: #a6adc2; }

  /* City name as the headline – like the earlier city cards */
  .appc__title { font-size: 22px; color: var(--color-brand-blue); }

  .appc__subtitle {
    font-size:   14px;
    font-weight: 700;
    color:       var(--color-text-muted);
    margin-top:  -6px;
  }

  .appc__note {
    font-size:   13px;
    line-height: 1.6;
    color:       var(--color-text-muted);
  }

  /* "Application open until …" above the button (directApply) */
  .appc__deadline {
    font-size:   15px;
    font-weight: 700;
    line-height: 1.5;
    color:       var(--color-text-heading);
  }

  .appc__rows { display: flex; flex-direction: column; gap: 6px; margin: 0; }
  /* Value stays on one line ("6 November 12:00"); if label and value do
     not fit side by side, the value moves below the label, right-aligned. */
  .appc__row  { display: flex; flex-wrap: wrap; justify-content: space-between; column-gap: var(--space-4); row-gap: 2px; }
  .appc__row dt { font-size: 14px; color: var(--color-text-muted); }
  .appc__row dd { font-size: 14px; font-weight: 800; color: var(--color-text-heading); margin: 0 0 0 auto; white-space: nowrap; }

  .appc__btn {
    margin-top:      auto;
    white-space:     nowrap;
    text-align:      center;
    font-family:     var(--font-display);
    font-size:       15px;
    font-weight:     var(--fw-bold);
    color:           var(--color-text-on-brand);
    background:      var(--color-brand-blue);
    border:          2px solid transparent;
    border-radius:   var(--radius-pill);
    padding:         13px 28px;
    text-decoration: none;
    transition:      background var(--transition-fast), border-color var(--transition-fast);
  }

  .appc__btn:hover { background: var(--color-brand-blue-dark); text-decoration: none; }

  /* On the city-page hero photo: same shadow as before */
  .appc--hero { box-shadow: 0 20px 48px rgba(6, 10, 30, 0.35); }
</style>
