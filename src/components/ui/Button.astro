---
// src/components/ui/Button.astro
// Wiederverwendbarer CTA-Button. variant "primary" = Markenblau,
// "secondary" = Violett-Akzent (vgl. Footer "Notify me"),
// "ghost" = transparent mit weißem Rand (für Einsatz auf dunklem/Gradient-Hero).

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  external?: boolean;
}

const { href, variant = "primary", external = false } = Astro.props;
---

<a
  href={href}
  class={`btn btn--${variant}`}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-sm);
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    text-decoration: none;
    transition: background var(--transition-fast), color var(--transition-fast),
      border-color var(--transition-fast);
    white-space: nowrap;
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn--primary {
    background: var(--color-brand-blue);
    color: var(--color-text-on-brand);
    border: 1px solid transparent;
  }

  .btn--primary:hover {
    background: var(--color-brand-blue-dark);
  }

  .btn--secondary {
    background: var(--color-accent-violet);
    color: var(--color-text-on-brand);
    border: 1px solid transparent;
  }

  .btn--secondary:hover {
    background: var(--color-accent-violet-dark);
  }

  .btn--ghost {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-text-on-brand);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring-on-dark);
  }
</style>
