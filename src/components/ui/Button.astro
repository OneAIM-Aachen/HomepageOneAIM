---
// src/components/ui/Button.astro
// Reusable CTA button following the OneAIM Brand Style Guide.
//
// variant="primary"   → AIM Blue #0052E9 (primary color, trust/medicine)
// variant="secondary" → pink-purple gradient #D400FF → #8D2DF1
//                        (creativity/innovation, per the guide always as a duo)

interface Props {
  href:      string;
  variant?:  "primary" | "secondary";
  external?: boolean;
  class?:    string;
}

const { href, variant = "primary", external = false, class: className } = Astro.props as Props;
---

<a
  href={href}
  class:list={[`btn btn--${variant}`, className]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);

    /* Raleway Bold, as prescribed in the guide for all text */
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-body);
    line-height: 1;

    padding: 14px 28px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    text-decoration: none;
    border: none;
    cursor: pointer;

    transition:
      opacity        var(--transition-fast),
      transform      var(--transition-fast),
      box-shadow     var(--transition-fast);
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0);
    opacity: 1;
  }

  .btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Primary: AIM Blue – first primary color (Style Guide p. 6) */
  .btn--primary {
    background: var(--color-brand-blue);   /* #0052E9 */
    color:      var(--color-text-on-brand);
    box-shadow: 0 6px 18px rgba(0, 82, 233, 0.28);
  }

  .btn--primary:hover {
    background: #0041ba;
    opacity: 1;
  }

  /* Secondary: pink + purple as a gradient – per the guide always a duo */
  /* (Style Guide p. 9–10: "Usually use together as graduation")          */
  .btn--secondary {
    background: transparent;
    color:      var(--color-brand-blue);
    border:     1.5px solid rgba(0, 82, 233, 0.35);
  }

  .btn--secondary:hover {
    background: rgba(0, 82, 233, 0.06);
  }

  /* ── Homepage hero buttons (München / Aachen) ─────────────────────
     Larger and slightly transparent. Only these two buttons are affected.
     Adjust padding and font size here – takes effect immediately.     */
  .btn.hero-city-btn {
    padding:   var(--space-4) var(--space-12);   /* ← size */
    font-size: var(--fs-body-lg);               /* ← font */
    opacity:   0.82;                            /* ← transparency (0–1) */
  }

  .btn.hero-city-btn:hover {
    opacity: 1;
  }
</style>
