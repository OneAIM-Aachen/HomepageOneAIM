---
// src/components/ui/CookieBanner.astro
//
// Cookie banner – appears on the first visit to the website.
// The decision is stored in localStorage (no cookie of its own).
//
// TO ENABLE / DISABLE THE BANNER:
//   In BaseLayout.astro: comment <CookieBanner /> in or out.
//
// TO ADJUST THE BANNER TEXT:
//   Edit the text between the <p> tags below directly.
---

<div id="cookie-banner" class="cookie-banner" role="dialog"
     aria-live="polite" aria-label="Datenschutzhinweis" hidden>

  <div class="cookie-banner__inner">
    <div class="cookie-banner__text">
      <p>
        Diese Website verwendet <strong>Google Fonts</strong>, um die Schriftart
        Raleway zu laden. Dabei wird Ihre IP-Adresse an Google-Server übertragen.
        Weitere Informationen finden Sie in unserer
        <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
    </div>

    <div class="cookie-banner__actions">
      <button id="cookie-accept" class="cookie-banner__btn cookie-banner__btn--accept"
              type="button">
        Verstanden
      </button>
      <button id="cookie-decline" class="cookie-banner__btn cookie-banner__btn--decline"
              type="button">
        Ablehnen
      </button>
    </div>
  </div>

</div>

<style>
  .cookie-banner {
    position:   fixed;
    bottom:     0;
    left:       0;
    right:      0;
    z-index:    999;
    background: var(--color-bg-footer);
    color:      var(--color-text-on-dark);
    border-top: 2px solid var(--color-brand-blue);
    padding:    var(--space-4) var(--container-padding);
  }

  .cookie-banner__inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             var(--space-6);
    max-width:       var(--container-max);
    margin-inline:   auto;
    flex-wrap:       wrap;
  }

  .cookie-banner__text {
    flex: 1;
    min-width: 260px;
  }

  .cookie-banner__text p {
    font-size:   var(--fs-small);
    color:       rgba(255, 255, 255, 0.88);
    line-height: var(--lh-body);
    margin:      0;
  }

  .cookie-banner__text a {
    color:           var(--color-brand-blue-light);
    text-decoration: underline;
  }

  .cookie-banner__actions {
    display:    flex;
    gap:        var(--space-3);
    flex-shrink: 0;
  }

  .cookie-banner__btn {
    padding:       var(--space-2) var(--space-6);
    border-radius: var(--radius-sm);
    font-family:   var(--font-display);
    font-weight:   var(--fw-bold);
    font-size:     var(--fs-small);
    cursor:        pointer;
    border:        none;
    transition:    background var(--transition-fast), opacity var(--transition-fast);
  }

  .cookie-banner__btn--accept {
    background: var(--color-brand-blue);
    color:      var(--color-text-on-brand);
  }
  .cookie-banner__btn--accept:hover { background: var(--color-brand-blue-dark); }

  .cookie-banner__btn--decline {
    background: transparent;
    color:      rgba(255, 255, 255, 0.70);
    border:     1px solid rgba(255, 255, 255, 0.25);
  }
  .cookie-banner__btn--decline:hover { opacity: 0.80; }

  .cookie-banner__btn:focus-visible {
    outline:    none;
    box-shadow: var(--focus-ring-on-dark);
  }
</style>

<script>
  const STORAGE_KEY = "oneaim-cookie-consent";
  const banner      = document.getElementById("cookie-banner");
  const btnAccept   = document.getElementById("cookie-accept");
  const btnDecline  = document.getElementById("cookie-decline");

  // Only show the banner if no decision has been made yet
  if (!localStorage.getItem(STORAGE_KEY)) {
    banner?.removeAttribute("hidden");
  }

  function dismiss(choice: "accepted" | "declined") {
    localStorage.setItem(STORAGE_KEY, choice);
    banner?.setAttribute("hidden", "");
  }

  btnAccept?.addEventListener("click", () => dismiss("accepted"));
  btnDecline?.addEventListener("click", () => dismiss("declined"));
</script>
