    <button type="button" class="impressum-switch__btn is-active" data-city-btn="muenchen" aria-pressed="true">München</button>
    <button type="button" class="impressum-switch__btn" data-city-btn="aachen" aria-pressed="false">Aachen</button>
  </div>

