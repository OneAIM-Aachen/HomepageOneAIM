<style>
  .impressum-switch {
    display:       flex;
    gap:           10px;
    flex-wrap:     wrap;
    margin-bottom: var(--space-2);
  }

  .impressum-switch__btn {
    border:        1px solid var(--color-border-subtle);
    background:    var(--color-bg-surface);
    color:         var(--color-text-body);
    border-radius: var(--radius-pill);
    padding:       10px 22px;
    font-family:   var(--font-display);
    font-size:     14px;
    font-weight:   800;
    cursor:        pointer;
    transition:    background var(--transition-fast), color var(--transition-fast),
                   border-color var(--transition-fast);
  }

  .impressum-switch__btn:hover { border-color: var(--color-brand-blue); color: var(--color-brand-blue); }

  .impressum-switch__btn.is-active {
    background:   var(--color-brand-blue);
    border-color: var(--color-brand-blue);
    color:        var(--color-text-on-brand);
  }
</style>

<script>
  // Standort-Umschalter: Buttons blenden die jeweils andere Vereins-Section
  // aus. /impressum#aachen wählt Aachen direkt vor.
  const switcher = document.querySelector<HTMLElement>("[data-impressum-switch]");
  const buttons  = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-city-btn]"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-city-section]"));

  if (switcher && buttons.length && sections.length) {
    switcher.removeAttribute("hidden");

    function show(city: string) {
      buttons.forEach(b => {
        const on = b.dataset.cityBtn === city;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
      });
      sections.forEach(s => s.toggleAttribute("hidden", s.dataset.citySection !== city));
    }

    buttons.forEach(b => b.addEventListener("click", () => show(b.dataset.cityBtn ?? "muenchen")));

    const fromHash = location.hash.replace("#", "");
    show(buttons.some(b => b.dataset.cityBtn === fromHash) ? fromHash : "muenchen");
  }
</script>
