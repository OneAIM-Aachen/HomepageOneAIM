---
// src/pages/index.astro
//
// Startseite von OneAIM.
//
// Reihenfolge der Sections:
//   1. MapHero         – DACH-Karte mit Standort-Pins, Headline, CTAs
//   2. PartnersSection – Logo-Laufband (Auswahl aus partners.ts)
//   3. WhatIsOneAIM    – Foto + Scrim, "What is OneAIM?"
//   4. ProgramsBento   – Bento-Raster aller Programme
//   5. JoinSection     – Abschluss-Banner "Sounds interesting?"

import BaseLayout        from "../layouts/BaseLayout.astro";
import AnnouncementBanner from "../components/sections/AnnouncementBanner.astro";
import MapHero           from "../components/sections/MapHero.astro";
import PartnersSection   from "../components/sections/PartnersSection.astro";
import WhatIsOneAIM      from "../components/sections/WhatIsOneAIM.astro";
import ProgramsBento     from "../components/sections/ProgramsBento.astro";
import JoinSection       from "../components/sections/JoinSection.astro";
import NewsSection       from "../components/sections/NewsSection.astro";
// LogoGallery wurde bewusst entfernt – ersetzt durch PartnersSection mit Karussell.
---

<BaseLayout
  title="Home"
  description="OneAIM – Germany's first student-led interdisciplinary initiative in MedTech. Active in Munich, Aachen and Frankfurt."
>
  <!-- ⓪ Ankündigungsband: offene/angekündigte AIM-Connect-Runden -->
  <AnnouncementBanner />

  <!-- ① Hero: Headline, Branding, CTA-Buttons -->
  <MapHero />

  <!-- ② Sponsoren/Partner-Karussell – direkt unter dem Hero -->
  <PartnersSection />

  <!-- ③ Introduction – Wer sind wir? (Entwurf 2A: Foto + Scrim) -->
  <WhatIsOneAIM />

  <!-- ④ Programme – Bento-Mosaik (Entwurf 4A) -->
  <ProgramsBento />

  <!-- ⑤ Abschluss-Banner: Wege zu OneAIM (Entwurf 9A) -->
  <JoinSection />

  <!-- ⑥ News-Band: neueste Beiträge aller Standorte -->
  <NewsSection />

</BaseLayout>
