---
// src/pages/index.astro
//
// OneAIM home page.
//
// Order of the sections:
//   1. MapHero         – DACH map with location pins, headline, CTAs
//   2. PartnersSection – logo marquee (selection from partners.ts)
//   3. WhatIsOneAIM    – photo + scrim, "What is OneAIM?"
//   4. ProgramsBento   – bento grid of all programs
//   5. JoinSection     – closing banner "Sounds interesting?"

import BaseLayout        from "../layouts/BaseLayout.astro";
import AnnouncementBanner from "../components/sections/AnnouncementBanner.astro";
import MapHero           from "../components/sections/MapHero.astro";
import PartnersSection   from "../components/sections/PartnersSection.astro";
import WhatIsOneAIM      from "../components/sections/WhatIsOneAIM.astro";
import ProgramsBento     from "../components/sections/ProgramsBento.astro";
import JoinSection       from "../components/sections/JoinSection.astro";
import NewsSection       from "../components/sections/NewsSection.astro";
// LogoGallery was deliberately removed – replaced by PartnersSection with a carousel.
---

<BaseLayout
  title="Home"
  description="OneAIM – Germany's first student-led interdisciplinary initiative in MedTech. Active in Munich, Aachen and Frankfurt."
>
  <!-- ⓪ Announcement band: open/announced AIM Connect rounds -->
  <AnnouncementBanner />

  <!-- ① Hero: headline, branding, CTA buttons -->
  <MapHero />

  <!-- ② Sponsor/partner carousel – directly below the hero -->
  <PartnersSection />

  <!-- ③ Introduction – who are we? (draft 2A: photo + scrim) -->
  <WhatIsOneAIM />

  <!-- ④ Programs – bento mosaic (draft 4A) -->
  <ProgramsBento />

  <!-- ⑤ Closing banner: ways to OneAIM (draft 9A) -->
  <JoinSection />

  <!-- ⑥ News band: latest posts from all chapters -->
  <NewsSection />

</BaseLayout>
