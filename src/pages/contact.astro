---
// src/pages/contact.astro
//
// Kontaktseite: eine Karte je Standort mit Instagram und E-Mail.
// Alles kommt aus der Standort-Datenbank (cityData.ts): instagramHref
// und contactEmail dort pflegen – ein neuer Standort erscheint automatisch.

import BaseLayout from "../layouts/BaseLayout.astro";
import { cities } from "../data/cityData";
---

<BaseLayout
  title="Contact Us"
  description="Contact OneAIM: Instagram and email for the chapters in Munich, Aachen and Frankfurt."
>
  <!-- Kopfbereich -->
  <section class="contact-header" aria-labelledby="contact-page-heading">
    <div class="container contact-header__inner">
      <h1 id="contact-page-heading">Contact Us</h1>
      <p class="contact-header__sub">
        Have a question or want to get in touch? Reach out to the chapter
        closest to you, on Instagram or by email.
      </p>
    </div>
  </section>

  <!-- Standort-Karten -->
  <section class="contact-locations" aria-label="Contact details per chapter">
    <div class="container contact-locations__grid">
      {cities.map(city => (
        <article class="contact-card">
          <h2 class="contact-card__city">{city.displayName}</h2>
          <p class="contact-card__desc">
            For everything about OneAIM {city.displayName} and the programs at
            the {city.displayName} chapter.
          </p>

          <div class="contact-card__links">
            {city.instagramHref && (
              <a
                href={city.instagramHref}
                class="contact-card__link-row"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`OneAIM ${city.displayName} on Instagram (opens in new tab)`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
                {city.instagram ?? "Instagram"}
              </a>
            )}
            {city.contactEmail && (
              <a
                href={`mailto:${city.contactEmail}`}
                class="contact-card__link-row"
                aria-label={`Email OneAIM ${city.displayName}`}
              >
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
                  <path fill="none" stroke="currentColor" stroke-width="1.5"
                        stroke-linecap="round" stroke-linejoin="round"
                        d="M2.5 5.5h15v10h-15zM2.5 5.5l7.5 6 7.5-6"/>
                </svg>
                {city.contactEmail}
              </a>
            )}
          </div>

          <a href={`/${city.slug}`} class="contact-card__link">
            Go to the {city.displayName} page →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Kopfbereich ────────────────────────────────────── */
  .contact-header {
    background:    var(--color-bg-subtle);
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .contact-header__inner { display: flex; flex-direction: column; gap: var(--space-3); }
  .contact-header__inner h1 { font-size: var(--fs-h1); }

  .contact-header__sub {
    font-size: var(--fs-body-lg);
    color:     var(--color-text-muted);
    max-width: 560px;
    margin:    0;
  }

  /* ── Standort-Grid ──────────────────────────────────── */
  .contact-locations {
    background:    var(--color-bg-page);
    padding-block: var(--space-12) var(--space-24);
  }

  .contact-locations__grid {
    display:               grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap:                   var(--space-6);
  }

  /* ── Einzelne Kontaktkarte ──────────────────────────── */
  .contact-card {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
    padding:        var(--space-8);
    background:     var(--color-bg-surface);
    border:         1px solid var(--color-border-subtle);
    border-radius:  var(--radius-lg);
    box-shadow:     var(--shadow-card);
  }

  .contact-card__city { font-size: var(--fs-h2); color: var(--color-brand-blue); }

  .contact-card__desc {
    font-size:   var(--fs-body);
    line-height: var(--lh-body);
    color:       var(--color-text-body);
  }

  .contact-card__links { display: flex; flex-direction: column; gap: var(--space-2); }

  .contact-card__link-row {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-2);
    align-self:      flex-start;
    font-family:     var(--font-display);
    font-weight:     var(--fw-bold);
    font-size:       var(--fs-body);
    color:           var(--color-text-heading);
    padding:         8px 14px;
    border:          1px solid var(--color-border-subtle);
    border-radius:   var(--radius-pill);
    text-decoration: none;
    transition:      color var(--transition-fast), border-color var(--transition-fast);
    word-break:      break-all;
  }

  .contact-card__link-row:hover {
    color:           var(--color-brand-blue);
    border-color:    var(--color-brand-blue);
    text-decoration: none;
  }

  .contact-card__link {
    margin-top:  auto;
    font-size:   var(--fs-small);
    font-weight: var(--fw-semibold);
    color:       var(--color-brand-blue);
  }
</style>
