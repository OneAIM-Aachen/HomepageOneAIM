---
// src/pages/contact.astro
//
// Dedizierte Kontaktseite.
// Zeigt die E-Mail-Adressen der einzelnen Standorte.
//
// E-MAIL-ADRESSEN ÄNDERN:
// Die Kontaktdaten der Standorte stehen direkt unten im locations-Array.
// Einfach die jeweilige email-Adresse anpassen – keine Komponente nötig.

import BaseLayout from "../layouts/BaseLayout.astro";

const locations = [
  {
    city:        "München",
    slug:        "muenchen",
    email:       "muenchen@platzhalter-oneaim.de",   // ← vor Go-Live ersetzen
    description: "Für alle Fragen rund um OneAIM München, AIM Connect und AIM Code am Standort München.",
  },
  {
    city:        "Aachen",
    slug:        "aachen",
    email:       "aachen@platzhalter-oneaim.de",      // ← vor Go-Live ersetzen
    description: "Für alle Fragen rund um OneAIM Aachen, AIM Connect und AIM Code am Standort Aachen.",
  },
];
---

<BaseLayout
  title="Contact Us"
  description="Kontaktiere OneAIM – Emailadressen für München und Aachen."
>
  <!-- Kopfbereich -->
  <section class="contact-header" aria-labelledby="contact-page-heading">
    <div class="container contact-header__inner">
      <h1 id="contact-page-heading">Contact Us</h1>
      <p class="contact-header__sub">
        Du hast eine Frage oder möchtest mit uns in Kontakt treten?
        Schreib uns direkt an den Standort, der dir am nächsten ist.
      </p>
    </div>
  </section>

  <!-- Standort-Karten -->
  <section class="contact-locations" aria-label="Kontaktadressen der Standorte">
    <div class="container contact-locations__grid">
      {locations.map(loc => (
        <article class="contact-card">
          <!-- Standort-Überschrift -->
          <h2 class="contact-card__city">{loc.city}</h2>
          <p class="contact-card__desc">{loc.description}</p>

          <!-- E-Mail als klickbarer Link -->
          <a
            href={`mailto:${loc.email}`}
            class="contact-card__email"
            aria-label={`E-Mail an OneAIM ${loc.city} senden`}
          >
            <svg viewBox="0 0 20 20" width="18" height="18"
                 aria-hidden="true" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round"
                    d="M2.5 5.5h15v10h-15zM2.5 5.5l7.5 6 7.5-6"/>
            </svg>
            {loc.email}
          </a>

          <!-- Link zur Stadtseite -->
          <a href={`/${loc.slug}`} class="contact-card__link">
            Zur {loc.city}-Seite →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Kopfbereich ────────────────────────────────────── */
  .contact-header {
    background:    var(--color-bg-subtle);
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .contact-header__inner {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
  }

  .contact-header__inner h1 { font-size: var(--fs-h1); }

  .contact-header__sub {
    font-size: var(--fs-body-lg);
    color:     var(--color-text-muted);
    max-width: 560px;
    margin:    0;
  }

  /* ── Standort-Grid ──────────────────────────────────── */
  .contact-locations {
    background:    var(--color-bg-page);
    padding-block: var(--space-12) var(--space-24);
  }

  .contact-locations__grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   var(--space-6);
  }

  @media (max-width: 640px) {
    .contact-locations__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Einzelne Kontaktkarte ──────────────────────────── */
  .contact-card {
    background:     var(--color-bg-surface);
    border-radius:  var(--radius-md);
    border:         1px solid var(--color-border-subtle);
    box-shadow:     var(--shadow-card);
    padding:        var(--space-8);
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
  }

  .contact-card__city {
    font-size:   var(--fs-h2);
    font-weight: var(--fw-bold);
    color:       var(--color-brand-blue);
    margin:      0;
  }

  .contact-card__desc {
    font-size:   var(--fs-body);
    color:       var(--color-text-body);
    line-height: var(--lh-body);
    margin:      0;
  }

  /* E-Mail-Button */
  .contact-card__email {
    display:         inline-flex;
    align-items:     center;
    gap:             var(--space-3);
    padding:         var(--space-3) var(--space-6);
    background:      var(--color-brand-blue);
    color:           var(--color-text-on-brand);
    border-radius:   var(--radius-sm);
    font-family:     var(--font-display);
    font-weight:     var(--fw-medium);
    font-size:       var(--fs-body);
    text-decoration: none;
    align-self:      flex-start;
    transition:
      background var(--transition-fast),
      transform  var(--transition-fast);
  }

  .contact-card__email:hover {
    background:      var(--color-brand-blue-dark);
    transform:       translateY(-1px);
    text-decoration: none;
  }

  .contact-card__email:focus-visible {
    outline:    none;
    box-shadow: var(--focus-ring);
  }

  /* Link zur Stadtseite */
  .contact-card__link {
    font-size:   var(--fs-small);
    font-weight: var(--fw-medium);
    color:       var(--color-brand-blue);
    margin-top:  auto;
  }

  .contact-card__link:hover { text-decoration: underline; }
</style>
