---
// src/pages/news/index.astro
// News-Übersicht. Inhalte kommen aus src/data/newsData.ts (DUMMY-Daten).

import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentSection from "../../components/sections/ContentSection.astro";
import ListItemCard from "../../components/cards/ListItemCard.astro";
import PlaceholderCard from "../../components/cards/PlaceholderCard.astro";
import DummyNotice from "../../components/ui/DummyNotice.astro";
import { newsItems } from "../../data/newsData";

const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title="News" description="Aktuelle News von OneAIM aus München und Aachen.">
  <ContentSection heading="News" background="page">
    <p>
      Hier findest du Updates zu Programmen, Events und Kooperationen von OneAIM – aus München
      und Aachen.
    </p>
  </ContentSection>

  <section class="news-list-section" aria-label="News-Beiträge">
    <div class="container">
      <DummyNotice text="Alle unten aufgeführten News sind Platzhalterinhalte. Vor dem Live-Gang durch echte Beiträge ersetzen." />

      <ul class="news-list-section__list">
        {
          newsItems.map((item) => (
            <ListItemCard
              title={item.title}
              meta={dateFormatter.format(new Date(item.date))}
              description={item.excerpt}
              isDummy
            />
          ))
        }

        <PlaceholderCard message="Weitere News folgen in Kürze. Dieser Platz ist für künftige Beiträge reserviert." />
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .news-list-section {
    padding-block: var(--space-8) var(--space-24);
    background: var(--color-bg-page);
  }

  .news-list-section__list {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
