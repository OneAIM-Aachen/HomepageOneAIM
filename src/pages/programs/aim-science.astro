---
// src/pages/programs/aim-science.astro
//
// Dedicated AIM Science page (draft 1a, "AIM Science Page Options":
// light editorial, matching the other program pages). Replaces the
// generic program page from [program].astro (excluded there).
//
// Bands:
//   ① Hero            – light blue band, photo on the right, CTAs
//   ② What it is
//   ③ Our projects    – project cards (PROJECTS below) + "Pitch your idea"

import BaseLayout from "../../layouts/BaseLayout.astro";

// ── Research projects – new project: add an entry ─────────────────────
const projects = [
  { area: "Large language models",
    title: "Can AI chatbots pass the medical state examination?",
    text:  "We evaluate whether AI chatbots can pass the second medical state examination, benchmarking their medical knowledge against the standard every physician in Germany has to meet.",
    tags:  ["LLM benchmarking", "Medical exams"] },
  { area: "Generative imaging",
    title: "How realistic are AI-generated patient images?",
    text:  "We explore the capabilities of image generators in creating realistic images of patients with specific diseases, and what that means for medical education and research.",
    tags:  ["Image generation", "Clinical realism"] },
];
---

<BaseLayout
  title="AIM Science"
  description="AIM Science: we put medical AI to the test, from chatbots taking the medical state examination to image generators producing realistic patient images."
>
  <article class="acs" aria-label="AIM Science program">
    <div class="container">
      <div class="acs__panel">

        <!-- ① Hero -->
        <header class="acs__hero">
          <div class="acs__hero-copy">
            <p class="acs__overline">Research at OneAIM</p>
            <h1 class="acs__title">AIM Science</h1>
            <p class="acs__lead">
              We put medical AI to the test: from chatbots taking the medical
              state examination to image generators producing realistic patient
              images.
            </p>
            <div class="acs__hero-actions">
              <a class="acs__btn" href="#projects">Our projects ↓</a>
              <a class="acs__btn acs__btn--ghost" href="/contact">Join the research</a>
            </div>
          </div>
          <img
            class="acs__hero-img"
            src="/images/science/research.jpg"
            alt="AIM Science members working on a research project"
            loading="eager"
            decoding="async"
          />
        </header>

        <!-- ② What it is -->
        <section class="acs__what" aria-labelledby="acs-what">
          <div class="acs__what-head">
            <p class="acs__overline">What it is</p>
            <h2 id="acs-what" class="acs__h2">Advancing AI research in healthcare</h2>
          </div>
          <p class="acs__what-text">
            OneAIM members are passionate about advancing AI research in
            healthcare. We actively engage in innovative projects, such as
            evaluating whether AI chatbots can pass the second medical state
            examination or exploring the capabilities of image generators in
            creating realistic images of patients with specific diseases.
          </p>
        </section>

        <!-- ③ Our projects -->
        <section class="acs__projects" id="projects" aria-labelledby="acs-projects">
          <div class="acs__section-head">
            <p class="acs__overline">Our projects</p>
            <h2 id="acs-projects" class="acs__h2">What we are working on</h2>
          </div>
          <div class="acs__project-grid">
            {projects.map(p => (
              <div class="acs__project">
                <p class="acs__project-area">{p.area}</p>
                <h3 class="acs__project-title">{p.title}</h3>
                <p class="acs__project-text">{p.text}</p>
                <div class="acs__project-tags">
                  {p.tags.map(t => <span>{t}</span>)}
                </div>
              </div>
            ))}
          </div>
          <div class="acs__pitch">
            <div class="acs__pitch-copy">
              <p class="acs__pitch-title">Your project?</p>
              <p class="acs__pitch-text">
                Have a research idea at the intersection of AI and medicine? We
                are always open for new projects.
              </p>
            </div>
            <a class="acs__btn acs__btn--sm acs__btn--outline" href="/contact">Pitch your idea</a>
          </div>
        </section>

      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .acs { background: var(--color-bg-page); padding-block: var(--space-12) var(--space-12); }

  .acs__panel {
    background:     var(--color-bg-surface);
    border-radius:  var(--radius-lg);
    box-shadow:     0 8px 32px rgba(35, 42, 207, 0.08);
    overflow:       hidden;
    display:        flex;
    flex-direction: column;
  }

  .acs__overline {
    font-size:      13px;
    font-weight:    var(--fw-bold);
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color:          var(--color-accent-purple);
  }

  .acs__h2 {
    font-size:      clamp(1.6rem, 1.2rem + 1.8vw, 2.25rem);
    letter-spacing: -0.5px;
    line-height:    1.15;
    color:          var(--color-text-heading);
    text-wrap:      pretty;
  }

  .acs__section-head { display: flex; flex-direction: column; gap: 12px; max-width: 760px; }

  /* ── Buttons ──────────────────────────────────────────────── */
  .acs__btn {
    display:         inline-block;
    align-self:      flex-start;
    background:      var(--color-brand-blue);
    color:           var(--color-text-on-brand);
    font-family:     var(--font-display);
    font-size:       15px;
    font-weight:     800;
    padding:         14px 28px;
    border-radius:   var(--radius-pill);
    text-decoration: none;
    white-space:     nowrap;
    transition:      background var(--transition-fast);
  }

  .acs__btn:hover { background: var(--color-brand-blue-dark); text-decoration: none; }
  .acs__btn--ghost { background: rgba(255, 255, 255, 0.7); color: var(--color-brand-blue); }
  .acs__btn--ghost:hover { background: #fff; }
  .acs__btn--sm { font-size: 14px; padding: 11px 24px; }
  .acs__btn--outline { background: #fff; color: var(--color-brand-blue); border: 1px solid var(--color-brand-blue); }
  .acs__btn--outline:hover { background: #E5EDFF; }

  /* ── ① Hero ───────────────────────────────────────────────── */
  .acs__hero {
    background:            #C9D8FF;
    padding:               clamp(var(--space-10, 40px), 5vw, 80px) clamp(var(--space-6), 5vw, 72px);
    display:               grid;
    grid-template-columns: 1.1fr 1fr;
    gap:                   clamp(var(--space-8), 4vw, 56px);
    align-items:           center;
  }

  .acs__hero-copy { display: flex; flex-direction: column; gap: 20px; }

  .acs__title {
    font-size:      clamp(2.4rem, 1.6rem + 3.4vw, 3.25rem);
    letter-spacing: -1px;
    line-height:    1.08;
    color:          #232ACF;
  }

  .acs__lead { font-size: 17px; line-height: 1.6; color: #232ACF; max-width: 480px; text-wrap: pretty; }
  .acs__hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .acs__hero-img { width: 100%; height: 340px; object-fit: cover; border-radius: 20px; display: block; }

  /* ── ② What it is ─────────────────────────────────────────── */
  .acs__what {
    padding:               clamp(var(--space-10, 40px), 5vw, 80px) clamp(var(--space-6), 5vw, 72px);
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(var(--space-8), 4.5vw, 64px);
    align-items:           start;
  }

  .acs__what-head { display: flex; flex-direction: column; gap: 16px; }
  .acs__what-text { font-size: 17px; line-height: 1.7; color: var(--color-text-body); text-wrap: pretty; }

  /* ── ③ Projects ───────────────────────────────────────────── */
  .acs__projects {
    padding:           0 clamp(var(--space-6), 5vw, 72px) clamp(var(--space-10, 40px), 5vw, 80px);
    display:           flex;
    flex-direction:    column;
    gap:               var(--space-8);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .acs__project-grid {
    display:               grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap:                   20px;
  }

  .acs__project {
    background:     #EDF2FF;
    border-radius:  20px;
    padding:        36px 32px;
    display:        flex;
    flex-direction: column;
    gap:            14px;
  }

  .acs__project-area {
    font-size:      12px;
    font-weight:    800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--color-brand-blue);
  }

  .acs__project-title { font-size: 22px; font-weight: 800; color: #232ACF; text-wrap: pretty; }
  .acs__project-text  { font-size: 15px; line-height: 1.65; color: var(--color-text-body); }

  .acs__project-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; }
  .acs__project-tags span {
    background:    #fff;
    color:         var(--color-text-body);
    font-size:     12px;
    font-weight:   var(--fw-bold);
    padding:       5px 12px;
    border-radius: var(--radius-pill);
    white-space:   nowrap;
  }

  .acs__pitch {
    border:          2px dashed #C4CBD9;
    border-radius:   20px;
    padding:         28px 32px;
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    gap:             24px;
    flex-wrap:       wrap;
  }

  .acs__pitch-copy { display: flex; flex-direction: column; gap: 6px; }
  .acs__pitch-title { font-size: 17px; font-weight: 800; color: #98A1B4; }
  .acs__pitch-text  { font-size: 14px; line-height: 1.6; color: #98A1B4; }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 960px) {
    .acs__hero { grid-template-columns: minmax(0, 1fr); }
    .acs__hero-img { height: 260px; }
    .acs__what { grid-template-columns: minmax(0, 1fr); }
    .acs__project-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
