---
// src/pages/programs/aim-code.astro
//
// Dedizierte AIM-Code-Seite (Entwurf 1a, "AIM Code Page Options":
// Light editorial, passend zur AIM-Connect-Seite). Ersetzt die
// generische Programmseite aus [program].astro (dort ausgenommen).
//
// Bänder:
//   ① Hero            – hellblaues Band, Foto rechts, CTAs
//   ② Why AIM Code    – Heading + 94%-Statistik + vier Vorteils-Karten
//   ③ Our courses     – AIM DataLab (Beginner) / AIM CodeLab (Advanced)
//   ④ Registrations   – EINE Karte je Standort, automatisch aus
//                       applications.ts (program "aim-code")
//
// Registrierungs-Karten wie auf der Connect-Seite: neue Runde mit
// program: "aim-code" in applications.ts anlegen → erscheint hier
// automatisch (offen / öffnet am … / in Planung).

import BaseLayout from "../../layouts/BaseLayout.astro";
import ApplicationCard from "../../components/ApplicationCard.astro";
import { cities } from "../../data/cityData";
import {
  getApplicationFor,
  getStatus,
  getTermLabel,
} from "../../data/applications";

const dateFmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});
const shortFmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long" });

type CardState = "open" | "upcoming" | "planned";

---

<BaseLayout
  title="AIM Code"
  description="AIM Code: free hands-on programming courses in healthcare technology, from your first line of Python to AI models for medical diagnostics."
>
  <article class="acd" aria-label="AIM Code program">
    <div class="container">
      <div class="acd__panel">

        <!-- ① Hero -->
        <header class="acd__hero">
          <div class="acd__hero-copy">
            <p class="acd__overline">Free coding courses</p>
            <h1 class="acd__title">AIM Code</h1>
            <p class="acd__lead">
              Your gateway to hands-on programming in healthcare technology,
              from your first line of Python to AI models for medical
              diagnostics. Free of charge, open to all disciplines, and run by
              your city's chapter.
            </p>
            <div class="acd__hero-actions">
              <a class="acd__btn" href="#register">Join the next course</a>
              <a class="acd__btn acd__btn--ghost" href="#courses">Our courses ↓</a>
            </div>
          </div>
          <img
            class="acd__hero-img"
            src="/images/code/ai-lecture.jpg"
            alt="AIM Code lecture on AI fundamentals"
            loading="eager"
            decoding="async"
          />
        </header>

        <!-- ② Why AIM Code -->
        <section class="acd__why" aria-labelledby="acd-why">
          <div class="acd__why-head">
            <div class="acd__why-heading">
              <p class="acd__overline">Why AIM Code</p>
              <h2 id="acd-why" class="acd__h2">
                Learn to code where it matters: healthcare
              </h2>
            </div>
            <div class="acd__stat">
              <span class="acd__stat-n">94%</span>
              <span class="acd__stat-l">would recommend our courses to their peers</span>
            </div>
          </div>
          <div class="acd__why-grid">
            <div class="acd__why-card">
              <h3>Real-world applications</h3>
              <p>Tackle medical data analysis, AI in diagnostics and predictive modeling.</p>
            </div>
            <div class="acd__why-card">
              <h3>Accessible and free</h3>
              <p>All bootcamps are free of charge, so everyone gets the chance to build tech skills.</p>
            </div>
            <div class="acd__why-card">
              <h3>Hands-on learning</h3>
              <p>Practical Python, AI and machine learning on real healthcare use cases.</p>
            </div>
            <div class="acd__why-card">
              <h3>Expert guidance</h3>
              <p>Mentorship from tutors across medicine, computer science and technology.</p>
            </div>
          </div>
        </section>

        <!-- ③ Our courses -->
        <section class="acd__courses" id="courses" aria-labelledby="acd-courses">
          <p id="acd-courses" class="acd__overline">Our courses</p>
          <div class="acd__course-grid">
            <div class="acd__course">
              <div class="acd__course-top">
                <span class="acd__course-name">AIM DataLab</span>
                <span class="acd__course-badge">Beginner</span>
              </div>
              <p class="acd__course-text">
                Start with the basics, no prior experience needed. Fundamentals
                of Python and essential tools like NumPy, Pandas and Matplotlib,
                with a focus on medical data processing. Offered locally by each
                chapter.
              </p>
              <div class="acd__course-tags">
                <span>Python</span>
                <span>NumPy · Pandas</span>
                <span>Medical data</span>
              </div>
            </div>
            <div class="acd__course">
              <div class="acd__course-top">
                <span class="acd__course-name">AIM CodeLab</span>
                <span class="acd__course-badge acd__course-badge--advanced">Advanced</span>
              </div>
              <p class="acd__course-text">
                Dive into artificial intelligence. Learn how to build AI models
                that can be applied to medical diagnostics and predictive
                analysis. Offered locally by each chapter.
              </p>
              <div class="acd__course-tags">
                <span>AI &amp; ML</span>
                <span>Diagnostics</span>
                <span>Predictive models</span>
              </div>
            </div>
          </div>
        </section>

        <!-- ④ Registrations – automatisch aus applications.ts -->
        <section class="acd__register" id="register" aria-labelledby="acd-register">
          <div class="acd__register-head">
            <p class="acd__overline">Open registrations</p>
            <h2 id="acd-register" class="acd__h2 acd__h2--blue">Join a course in your city</h2>
            <p class="acd__register-sub">
              AIM Code runs locally: each chapter organizes its own courses and
              registration.
            </p>
          </div>
          <div class="acd__register-grid">
            {cities.map(city => (
              <ApplicationCard city={city.slug} cityName={city.displayName} program="aim-code" ctaVerb="Register" hideEmptyCta />
            ))}
          </div>
        </section>


      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .acd { background: var(--color-bg-page); padding-block: var(--space-12) var(--space-24); }

  .acd__panel {
    background:     var(--color-bg-surface);
    border-radius:  var(--radius-lg);
    box-shadow:     0 8px 32px rgba(35, 42, 207, 0.08);
    overflow:       hidden;
    display:        flex;
    flex-direction: column;
  }

  .acd__overline {
    font-size:      13px;
    font-weight:    var(--fw-bold);
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color:          var(--color-accent-purple);
  }

  .acd__h2 {
    font-size:      clamp(1.6rem, 1.2rem + 1.8vw, 2.25rem);
    letter-spacing: -0.5px;
    line-height:    1.15;
    color:          var(--color-text-heading);
    text-wrap:      pretty;
  }

  .acd__h2--blue { color: #232ACF; }

  .acd__slot {
    display:         flex;
    align-items:     center;
    justify-content: center;
    width:           100%;
    height:          160px;
    padding:         var(--space-3);
    text-align:      center;
    font-size:       var(--fs-small);
    font-weight:     var(--fw-semibold);
    color:           var(--color-text-muted);
    background:      #F7F9FE;
    border:          2px dashed var(--color-border-subtle);
    border-radius:   14px;
  }

  /* ── Buttons ──────────────────────────────────────────────── */
  .acd__btn {
    display:         inline-block;
    align-self:      flex-start;
    background:      var(--color-brand-blue);
    color:           var(--color-text-on-brand);
    font-family:     var(--font-display);
    font-size:       15px;
    font-weight:     800;
    padding:         14px 28px;
    border-radius:   var(--radius-pill);
    text-decoration: none;
    transition:      background var(--transition-fast);
  }

  .acd__btn:hover { background: var(--color-brand-blue-dark); text-decoration: none; }

  .acd__btn--ghost { background: rgba(255, 255, 255, 0.7); color: var(--color-brand-blue); }

  .acd__btn--ghost:hover { background: #fff; }

  .acd__btn--sm { font-size: 14px; padding: 11px 22px; margin-top: auto; }

  /* ── ① Hero ───────────────────────────────────────────────── */
  .acd__hero {
    background:            #C9D8FF;
    padding:               clamp(var(--space-10, 40px), 5vw, 80px) clamp(var(--space-6), 5vw, 72px);
    display:               grid;
    grid-template-columns: 1.1fr 1fr;
    gap:                   clamp(var(--space-8), 4vw, 56px);
    align-items:           center;
  }

  .acd__hero-copy { display: flex; flex-direction: column; gap: 20px; }

  .acd__title {
    font-size:      clamp(2.4rem, 1.6rem + 3.4vw, 3.25rem);
    letter-spacing: -1px;
    line-height:    1.08;
    color:          #232ACF;
  }

  .acd__lead {
    font-size:   17px;
    line-height: 1.6;
    color:       #232ACF;
    max-width:   480px;
    text-wrap:   pretty;
  }

  .acd__hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .acd__hero-img {
    width:         100%;
    height:        340px;
    object-fit:    cover;
    border-radius: 20px;
    display:       block;
  }

  /* ── ② Why AIM Code ───────────────────────────────────────── */
  .acd__why {
    padding:        clamp(var(--space-10, 40px), 5vw, 80px) clamp(var(--space-6), 5vw, 72px);
    display:        flex;
    flex-direction: column;
    gap:            var(--space-8);
  }

  .acd__why-head {
    display:         flex;
    justify-content: space-between;
    align-items:     flex-end;
    gap:             var(--space-8);
    flex-wrap:       wrap;
  }

  .acd__why-heading {
    display:        flex;
    flex-direction: column;
    gap:            12px;
    max-width:      640px;
  }

  .acd__stat { display: flex; flex-direction: column; gap: 4px; }

  .acd__stat-n {
    font-size:   clamp(2rem, 1.5rem + 2vw, 2.75rem);
    font-weight: 800;
    color:       var(--color-brand-blue);
    line-height: 1;
  }

  .acd__stat-l {
    font-size:   13px;
    font-weight: var(--fw-semibold);
    color:       var(--color-text-body);
    max-width:   200px;
  }

  .acd__why-grid {
    display:               grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap:                   20px;
  }

  .acd__why-card {
    background:     #EDF2FF;
    border-radius:  20px;
    padding:        28px 24px;
    display:        flex;
    flex-direction: column;
    gap:            10px;
  }

  .acd__why-card h3 { font-size: 17px; font-weight: 800; color: #232ACF; }

  .acd__why-card p { font-size: 14px; line-height: 1.6; color: var(--color-text-body); }

  /* ── ③ Our courses ────────────────────────────────────────── */
  .acd__courses {
    padding:           0 clamp(var(--space-6), 5vw, 72px) clamp(var(--space-10, 40px), 5vw, 80px);
    display:           flex;
    flex-direction:    column;
    gap:               var(--space-8);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .acd__course-grid {
    display:               grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap:                   20px;
  }

  .acd__course {
    border:         1px solid var(--color-border-subtle);
    border-radius:  20px;
    padding:        36px 32px;
    display:        flex;
    flex-direction: column;
    gap:            14px;
  }

  .acd__course-top {
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    gap:             8px;
    flex-wrap:       wrap;
  }

  .acd__course-name { font-size: 24px; font-weight: 800; color: var(--color-brand-blue); }

  .acd__course-badge {
    background:    #EDF2FF;
    color:         #232ACF;
    font-size:     12px;
    font-weight:   800;
    padding:       4px 12px;
    border-radius: var(--radius-pill);
    white-space:   nowrap;
  }

  .acd__course-badge--advanced {
    background: linear-gradient(90deg, #8D2DF1, #D400FF);
    color:      #fff;
  }

  .acd__course-text { font-size: 15px; line-height: 1.65; color: var(--color-text-body); }

  .acd__course-tags {
    display:    flex;
    gap:        8px;
    flex-wrap:  wrap;
    margin-top: auto;
  }

  .acd__course-tags span {
    background:    #EEF1F7;
    color:         var(--color-text-body);
    font-size:     12px;
    font-weight:   var(--fw-bold);
    padding:       5px 12px;
    border-radius: var(--radius-pill);
    white-space:   nowrap;
  }

  /* ── ④ Registrations ──────────────────────────────────────── */
  .acd__register {
    background:        #EDF2FF;
    padding:           clamp(var(--space-10, 40px), 5vw, 72px) clamp(var(--space-6), 5vw, 72px);
    display:           flex;
    flex-direction:    column;
    gap:               var(--space-8);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .acd__register-head { display: flex; flex-direction: column; gap: 12px; max-width: 760px; }

  .acd__register-sub { font-size: 15px; line-height: 1.6; color: #232ACF; }

  .acd__register-grid {
    display:               grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap:                   20px;
  }

  .acd__city {
    background:     var(--color-bg-surface);
    border-radius:  20px;
    padding:        32px 28px;
    display:        flex;
    flex-direction: column;
    gap:            14px;
  }

  .acd__city--planned {
    background: transparent;
    border:     2px dashed #C4CBD9;
  }

  .acd__city-top {
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    gap:             8px;
    flex-wrap:       wrap;
  }

  .acd__city-name { font-size: 21px; font-weight: 800; color: var(--color-brand-blue); }

  .acd__city--planned .acd__city-name { color: #98A1B4; }

  .acd__city-badge {
    font-size:     12px;
    font-weight:   800;
    padding:       4px 12px;
    border-radius: var(--radius-pill);
    white-space:   nowrap;
  }

  .acd__city-badge--open     { background: #EDF2FF; color: var(--color-brand-blue); }
  .acd__city-badge--upcoming { background: #fff; color: var(--color-accent-purple); border: 1px solid #E0CCF9; }
  .acd__city-badge--planned  { background: #EEF1F7; color: #98A1B4; }

  .acd__city-line { font-size: 14px; line-height: 1.6; color: var(--color-text-body); }

  .acd__city--planned .acd__city-line { color: #98A1B4; }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 960px) {
    .acd__hero { grid-template-columns: minmax(0, 1fr); }
    .acd__hero-img { height: 260px; }
    .acd__why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .acd__course-grid, .acd__register-grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 560px) {
    .acd__why-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
