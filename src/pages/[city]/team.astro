---
// src/pages/[city]/team.astro
// Team – erzeugt aus EINER Datei für München & Aachen.

import CityLayout from "../../layouts/CityLayout.astro";
import ContentSection from "../../components/sections/ContentSection.astro";
import TeamGrid from "../../components/sections/TeamGrid.astro";
import { getCityStaticPaths } from "../../data/cityData";
import type { CityData } from "../../data/cityData";

export function getStaticPaths() {
  return getCityStaticPaths();
}

interface Props {
  city: CityData;
}

const { city } = Astro.props as Props;
---

<CityLayout city={city} pageTitle="Team">
  <ContentSection heading={`Das Team in ${city.displayName}`} background="page">
    <p>
      Die Menschen hinter OneAIM {city.displayName} – engagiert, interdisziplinär und mit einem
      gemeinsamen Ziel: MedTech-Innovation für Studierende greifbar zu machen.
    </p>
  </ContentSection>

  <TeamGrid members={city.team} />
</CityLayout>
