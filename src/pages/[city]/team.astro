---
// src/pages/[city]/team.astro
//
// Team-Seite für einen Standort (München / Aachen).
// Erzeugt via getStaticPaths() aus einer Datei zwei Seiten:
//   /muenchen/team
//   /aachen/team
//
// Daten kommen aus:
//   • src/data/cityData.ts  – Standort-Metadaten (Name, Hero-Text)
//   • src/data/team.ts      – Teammitglieder (gefiltert nach city)

import CityLayout  from "../../layouts/CityLayout.astro";
import TeamSection from "../../components/sections/TeamSection.astro";

import { getCityStaticPaths } from "../../data/cityData";
import { getTeamByCity       } from "../../data/team";
import type { CityData }       from "../../data/cityData";

export function getStaticPaths() {
  return getCityStaticPaths();
}

interface Props { city: CityData }
const { city } = Astro.props as Props;

// Teammitglieder für diesen Standort aus team.ts laden
const members = getTeamByCity(city.slug);
---

<CityLayout city={city} pageTitle="Team">
  <TeamSection
    members={members}
    heading={`Our team in ${city.displayName}`}
    subtext={`Get to know our department leads, department members and advisors.`}
    background="subtle"
  />
</CityLayout>
