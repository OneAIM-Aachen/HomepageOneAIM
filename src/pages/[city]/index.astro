---
// src/pages/[city]/index.astro
//
// Standortseite – erzeugt automatisch eine Seite pro Eintrag in der
// Standort-Datenbank (src/data/cityData.ts), aktuell /munich, /aachen
// und /frankfurt.
//
// Die Seite besteht nur aus der Blaupause CityBlueprint.astro. Alle
// Inhalte kommen aus den zentralen Datenbanken:
//   • cityData.ts     – Hero-Foto, Uni, Instagram, Gründungsjahr, Story …
//   • applications.ts – Bewerbungskarte + "Coming up"-Zeile
//   • newsData.ts     – News-Band
//   • teamData.ts     – Team-Karussell
// Solange Felder in cityData.ts fehlen, zeigt die Blaupause Platzhalter.

import BaseLayout     from "../../layouts/BaseLayout.astro";
import CityBlueprint  from "../../components/sections/CityBlueprint.astro";

import { getCityStaticPaths } from "../../data/cityData";
import type { CityData }       from "../../data/cityData";

export function getStaticPaths() {
  return getCityStaticPaths();
}

interface Props { city: CityData }
const { city } = Astro.props as Props;
---

<BaseLayout
  title={city.displayName}
  description={`OneAIM ${city.displayName} chapter overview.`}
>
  <CityBlueprint citySlug={city.slug} />
</BaseLayout>
