---
// src/pages/[city]/index.astro
//
// City page – automatically generates one page per entry in the
// city database (src/data/cityData.ts), currently /munich, /aachen
// and /frankfurt.
//
// The page consists only of the blueprint CityBlueprint.astro. All
// content comes from the central databases:
//   • cityData.ts     – hero photo, university, Instagram, founding year, story …
//   • applications.ts – application card + "Coming up" line
//   • newsData.ts     – news band
//   • teamData.ts     – team carousel
// As long as fields are missing in cityData.ts, the blueprint shows placeholders.

import BaseLayout     from "../../layouts/BaseLayout.astro";
import CityBlueprint  from "../../components/sections/CityBlueprint.astro";

import { getCityStaticPaths } from "../../data/cityData";
import type { CityData }       from "../../data/cityData";

export function getStaticPaths() {
  return getCityStaticPaths();
}

interface Props { city: CityData }
const { city } = Astro.props as Props;
---

<BaseLayout
  title={city.displayName}
  description={`OneAIM ${city.displayName} chapter overview.`}
>
  <CityBlueprint citySlug={city.slug} />
</BaseLayout>
