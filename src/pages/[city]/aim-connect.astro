---
// src/pages/[city]/aim-connect.astro
// AIM Connect – /muenchen/aim-connect und /aachen/aim-connect
//
// showApplicationInfo={true} + program="aimConnect"
// → zeigt die AIM-Connect-spezifische Bewerbungsphase aus application.ts

import CityLayout     from "../../layouts/CityLayout.astro";
import ContentSection from "../../components/sections/ContentSection.astro";
import IconCard       from "../../components/cards/IconCard.astro";
import Timeline       from "../../components/sections/Timeline.astro";
import FAQSection     from "../../components/sections/FAQSection.astro";
import { getFAQ }     from "../../data/faq";
import type { CityKey } from "../../data/faq";

import { connectMunichEvents } from "../../data/connect-munich";
import { connectAachenEvents } from "../../data/connect-aachen";
import { getCityStaticPaths }  from "../../data/cityData";
import type { CityData }        from "../../data/cityData";

export function getStaticPaths() {
  return getCityStaticPaths();
}

interface Props { city: CityData }
const { city } = Astro.props as Props;

const eventMap: Record<string, typeof connectMunichEvents> = {
  muenchen: connectMunichEvents,
  aachen:   connectAachenEvents,
};
const timelineEvents = eventMap[city.slug] ?? [];
const faqItems = getFAQ("aimConnect", city.slug as CityKey);
---

<CityLayout
  city={city}
  pageTitle="AIM Connect"
  showApplicationInfo={true}
  program="aimConnect"
>
  <ContentSection heading="What is" headingAccent="AIM Connect?" background="page">
    <p>{city.aimConnect.intro}</p>
  </ContentSection>

  <section class="aim-connect-cards" aria-label="Scope und Topic">
    <div class="container aim-connect-cards__grid">
      {city.aimConnect.cards.map(card => (
        <IconCard title={card.title} bullets={card.bullets} />
      ))}
    </div>
  </section>

  <Timeline
    events={timelineEvents}
    heading="Timeline"
    sortOrder="asc"
    background="subtle"
  />

  <FAQSection items={faqItems} heading="FAQ" background="page" />
</CityLayout>

<style>
  .aim-connect-cards {
    padding-block: var(--space-8) var(--space-16);
    background:    var(--color-bg-page);
  }
  .aim-connect-cards__grid {
    display:               grid;
    grid-template-columns: repeat(2, 1fr);
    gap:                   var(--space-6);
  }
  @media (max-width: 760px) {
    .aim-connect-cards__grid { grid-template-columns: 1fr; }
  }
</style>
