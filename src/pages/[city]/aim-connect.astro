---
// src/pages/[city]/aim-connect.astro
//
// AIM Connect – erzeugt aus EINER Datei für München & Aachen:
//   /muenchen/aim-connect
//   /aachen/aim-connect
//
// NEUE STADT ERGÄNZEN:
//   1. Datei src/data/connect-[city].ts anlegen
//   2. Import unten hinzufügen
//   3. In eventMap eintragen: { [city]: connectCityEvents }
//   → Keine Änderung an Timeline.astro oder EventCard.astro nötig.

import CityLayout      from "../../layouts/CityLayout.astro";
import ContentSection  from "../../components/sections/ContentSection.astro";
import IconCard        from "../../components/cards/IconCard.astro";
import Timeline        from "../../components/sections/Timeline.astro";

import { getCityStaticPaths } from "../../data/cityData";
import type { CityData }       from "../../data/cityData";

// ── Event-Daten pro Stadt ────────────────────────────────────────────────────
// Jede Stadt hat eine eigene Datendatei. Nur hier muss beim Ergänzen
// einer neuen Stadt etwas geändert werden.
import { connectMunichEvents } from "../../data/connect-munich";
import { connectAachenEvents } from "../../data/connect-aachen";
import FAQSection              from "../../components/sections/FAQSection.astro";
import { getFAQ }              from "../../data/faq";
import type { CityKey }        from "../../data/faq";

export function getStaticPaths() {
  return getCityStaticPaths();
}

interface Props { city: CityData }
const { city } = Astro.props as Props;

// Korrekte Events für den aktuellen Standort auswählen
const eventMap: Record<string, typeof connectMunichEvents> = {
  muenchen: connectMunichEvents,
  aachen:   connectAachenEvents,
};
const timelineEvents = eventMap[city.slug] ?? [];
const faqItems = getFAQ("aimConnect", city.slug as CityKey);
---

<CityLayout city={city} pageTitle="AIM Connect">

  <!-- ① Einleitungstext -->
  <ContentSection
    heading="What is"
    headingAccent="AIM Connect?"
    background="page"
  >
    <p>{city.aimConnect.intro}</p>
  </ContentSection>

  <!-- ② Scope + Topic Cards -->
  <section class="aim-connect-cards" aria-label="Scope und Topic">
    <div class="container aim-connect-cards__grid">
      {city.aimConnect.cards.map(card => (
        <IconCard title={card.title} bullets={card.bullets} />
      ))}
    </div>
  </section>

  <!-- ③ Timeline –direkt unterhalb der Einleitung -->
  <Timeline
    events={timelineEvents}
    heading="Timeline"
    sortOrder="asc"
    background="subtle"
  />

  <!-- ④ FAQ -->
  <FAQSection
    items={faqItems}
    heading="FAQ"
    background="page"
  />

</CityLayout>

<style>
  .aim-connect-cards {
    padding-block: var(--space-8) var(--space-16);
    background:    var(--color-bg-page);
  }

  .aim-connect-cards__grid {
    display:               grid;
    grid-template-columns: repeat(2, 1fr);
    gap:                   var(--space-6);
  }

  @media (max-width: 760px) {
    .aim-connect-cards__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
