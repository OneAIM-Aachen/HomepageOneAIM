---
// src/pages/publications/index.astro
//
// Publications-Übersicht.
// Layout:
//   • Neueste Publikation → großes Featured-Element ganz oben
//   • Ältere Publikationen → horizontale Kacheln mit Bild (wie News)
//
// Datenquelle: src/data/publicationsData.ts
// Neue Publikation: Eintrag dort ergänzen + Bild nach public/images/publications/

import BaseLayout  from "../../layouts/BaseLayout.astro";
import DummyNotice from "../../components/ui/DummyNotice.astro";
import { getSortedPublications } from "../../data/publicationsData";

const all     = getSortedPublications();   // neueste zuerst
const featured = all[0];                   // größte Karte oben
const rest     = all.slice(1);             // restliche als Kacheln
---

<BaseLayout
  title="Publications"
  description="Publikationen und Berichte rund um OneAIM, AIM Connect und AIM Code."
>

  <!-- ── Seiten-Kopf ─────────────────────────────────── -->
  <section class="pub-header" aria-labelledby="pub-page-heading">
    <div class="container pub-header__inner">
      <h1 id="pub-page-heading">Publications</h1>
      <p class="pub-header__sub">
        Publikationen, Berichte und Lernmaterialien aus der Arbeit von OneAIM.
      </p>
    </div>
  </section>

  <div class="pub-content">
    <div class="container">

      <DummyNotice
        text="Alle Publikationen sind Platzhalterinhalte – vor Go-Live durch echte Quellen ersetzen (src/data/publicationsData.ts)."
      />

      <!-- ── Featured: neueste Publikation ──────────────── -->
      {featured && (
        <article class="pub-featured" aria-label="Neueste Publikation">

          <div class="pub-featured__img-wrap">
            <img
              src={featured.image}
              alt={featured.imageAlt ?? `${featured.title} – Vorschaubild`}
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="pub-featured__body">
            <span class="pub-featured__label">Latest Publication</span>

            <h2 class="pub-featured__title">{featured.title}</h2>

            <p class="pub-featured__meta">
              {featured.authors.join(", ")}
              <span class="pub-featured__year">· {featured.year}</span>
            </p>

            <p class="pub-featured__desc">{featured.description}</p>
          </div>

        </article>
      )}

      <!-- ── Ältere Publikationen als Kacheln ────────────── -->
      {rest.length > 0 && (
        <section class="pub-list-section" aria-label="Weitere Publikationen">
          <h2 class="pub-list-section__heading">Weitere Publikationen</h2>

          <ul class="pub-list">
            {rest.map(pub => (
              <li class="pub-card">

                <div class="pub-card__img-wrap">
                  <img
                    src={pub.image}
                    alt={pub.imageAlt ?? `${pub.title} – Vorschaubild`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <div class="pub-card__body">
                  <h3 class="pub-card__title">{pub.title}</h3>

                  <p class="pub-card__meta">
                    {pub.authors.join(", ")}
                    <span class="pub-card__year">· {pub.year}</span>
                  </p>

                  <p class="pub-card__desc">{pub.description}</p>
                </div>

              </li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </div>

</BaseLayout>

<style>
  /* ── Seiten-Kopf ──────────────────────────────────── */
  .pub-header {
    background:    var(--color-bg-subtle);
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .pub-header__inner {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
  }

  .pub-header__inner h1 { font-size: var(--fs-h1); }

  .pub-header__sub {
    font-size: var(--fs-body-lg);
    color:     var(--color-text-muted);
    max-width: 560px;
    margin:    0;
  }

  /* ── Haupt-Inhaltsbereich ─────────────────────────── */
  .pub-content {
    background:    var(--color-bg-page);
    padding-block: var(--space-8) var(--space-24);
  }

  .pub-content .container {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-12);
  }

  /* ── Featured: neueste Publikation ───────────────── */
  .pub-featured {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   var(--space-6);
    align-items:           center;
    background:            var(--color-bg-surface);
    border-radius:         var(--radius-lg);
    border:                4px solid var(--color-border-subtle);
    box-shadow:            0 4px 24px rgba(0, 82, 233, 0.10);
    overflow:              hidden;
  }

  .pub-featured__img-wrap {
    height:   420px;
    overflow: hidden;
  }

  .pub-featured__img-wrap img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
  }

  .pub-featured__body {
    padding:        var(--space-10);
    display:        flex;
    flex-direction: column;
    gap:            var(--space-10);
  }

  /* "Latest Publication" Badge */
  .pub-featured__label {
    display:       inline-block;
    padding:       3px var(--space-4);
    border-radius: var(--radius-pill);
    background:    #EEF3FF;
    color:         var(--color-brand-blue-dark);
    font-size:     var(--fs-small);
    font-weight:   var(--fw-semibold);
    letter-spacing: 0.03em;
    align-self:    flex-start;
  }

  .pub-featured__title {
    font-size:   var(--fs-h2);
    font-weight: var(--fw-bold);
    color:       var(--color-text-heading);
    line-height: 1.25;
    margin:      0;
  }

  .pub-featured__meta {
    font-size:   var(--fs-body);
    font-weight: var(--fw-medium);
    color:       var(--color-brand-blue);
    margin:      0;
  }

  .pub-featured__year {
    color: var(--color-text-muted);
  }

  .pub-featured__desc {
    font-size:   var(--fs-body-lg);
    color:       var(--color-text-body);
    line-height: var(--lh-body);
    margin:      0;
  }

  /* Responsive: Featured einspaltig */
  @media (max-width: 860px) {
    .pub-featured {
      grid-template-columns: 1fr;
    }

    .pub-featured__img-wrap {
      height: 260px;
    }

    .pub-featured__body {
      padding: var(--space-6);
    }

    .pub-featured__title {
      font-size: var(--fs-h3);
    }
  }

  /* ── Weitere Publikationen ────────────────────────── */
  .pub-list-section__heading {
    font-size:     var(--fs-h3);
    color:         var(--color-text-muted);
    font-weight:   var(--fw-medium);
    margin-bottom: var(--space-6);
  }

  .pub-list {
    list-style:     none;
    margin:         0;
    padding:        0;
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
  }

  /* ── Kachel (wie News-Karte, horizontal) ─────────── */
  .pub-card {
    display:               grid;
    grid-template-columns: 240px 1fr;
    gap:                   var(--space-8);   /* Abstand zwischen Bild und Text */
    background:            var(--color-bg-surface);
    border-radius:         var(--radius-md);
    border:                1px solid var(--color-brand-blue-light);   /* sichtbarer Rand */
    box-shadow:            var(--shadow-card);
    overflow:              hidden;
    transition:
      box-shadow var(--transition-fast),
      transform  var(--transition-fast);
  }

  .pub-card:hover {
    box-shadow: 0 6px 24px rgba(0, 82, 233, 0.12);
    transform:  translateY(-2px);
  }

  .pub-card__img-wrap {
    height:   180px;
    overflow: hidden;
  }

  .pub-card__img-wrap img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
    transition: transform 0.4s ease;
  }

  .pub-card:hover .pub-card__img-wrap img {
    transform: scale(1.04);
  }

  .pub-card__body {
    padding:        var(--space-6);
    display:        flex;
    flex-direction: column;
    gap:            var(--space-2);
  }

  .pub-card__title {
    font-size:   var(--fs-h3);
    font-weight: var(--fw-bold);
    color:       var(--color-text-heading);
    line-height: 1.25;
    margin:      0;
  }

  .pub-card__meta {
    font-size:   var(--fs-small);
    font-weight: var(--fw-medium);
    color:       var(--color-brand-blue);
    margin:      0;
  }

  .pub-card__year {
    color: var(--color-text-muted);
  }

  .pub-card__desc {
    font-size:          var(--fs-body);
    color:              var(--color-text-body);
    line-height:        var(--lh-body);
    margin:             0;
    display:            -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow:           hidden;
  }

  /* Responsive: Kacheln einspaltig */
  @media (max-width: 640px) {
    .pub-card {
      grid-template-columns: 1fr;
    }

    .pub-card__img-wrap {
      height: 180px;
    }
  }
</style>
