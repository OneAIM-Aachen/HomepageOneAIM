---
// src/pages/publications/index.astro
//
// Publications overview – implementation of draft 7A from the
// Claude design project ("What is OneAIM Options.dc.html", section 7A).
//
// Structure:
//   1. Header with overline, title and introduction
//   2. Spotlight: the latest publication on a light blue surface
//   3. "All publications": compact row list with year and cover
//
// New publications are maintained exclusively in src/data/publicationsData.ts
// – this file does not need to be touched for that.

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedPublications } from "../../data/publicationsData";

const all      = getSortedPublications();
const featured = all[0];
---

<BaseLayout
  title="Publications"
  description="Books, papers and course material from OneAIM members."
>
  <section class="pubs">
    <div class="container pubs__panel">

      <!-- ① Header -->
      <header class="pubs__head">
        <p class="pubs__overline">Research &amp; writing</p>
        <h1 class="pubs__title">Publications</h1>
        <p class="pubs__lead">
          What our members research, write and publish, from books to papers.
        </p>
      </header>

      <!-- ② Spotlight -->
      {featured && (
        <div class="pubs__spotlight">
          <a class="pubs__cover" href={`/publications/${featured.id}`}>
            <img src={featured.image} alt={featured.imageAlt ?? ""} loading="eager" decoding="async" />
          </a>
          <div class="pubs__spotlight-body">
            {featured.badge && <span class="pubs__badge">{featured.badge}</span>}
            <h2 class="pubs__spotlight-title">
              <a href={`/publications/${featured.id}`}>{featured.title}</a>
            </h2>
            <p class="pubs__spotlight-text">{featured.description}</p>
            <p class="pubs__meta">{featured.authors.join(", ")} · {featured.year}</p>
            <div class="pubs__actions">
              <a class="pubs__btn" href={`/publications/${featured.id}`}>Read more →</a>
              {featured.link && (
                <a class="pubs__btn pubs__btn--ghost" href={featured.link.href}
                   target="_blank" rel="noopener noreferrer">
                  {featured.link.label} →
                </a>
              )}
            </div>
          </div>
        </div>
      )}

      <!-- ③ Complete list -->
      <section class="pubs__list" aria-labelledby="all-pubs-heading">
        <div class="pubs__list-head">
          <h2 id="all-pubs-heading">All publications</h2>
        </div>
        <ul>
          {all.map(p => (
            <li>
              <a class="pubs__row" href={`/publications/${p.id}`}>
                <span class="pubs__row-year">{p.year}</span>
                <span class="pubs__row-cover">
                  <img src={p.image} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="pubs__row-body">
                  <span class="pubs__row-title">{p.title}</span>
                  <span class="pubs__row-authors">{p.authors.join(", ")}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .pubs {
    background:    var(--color-bg-page);
    padding-block: var(--space-12) var(--space-12);
  }

  .pubs__panel {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-16);
  }

  /* ── Header ───────────────────────────────────────────────── */
  .pubs__head {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-3);
    max-width:      640px;
  }

  .pubs__overline {
    font-size:      13px;
    font-weight:    var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color:          var(--color-accent-purple);
  }

  .pubs__title {
    font-size:      clamp(2.2rem, 1.4rem + 3vw, 3.25rem);
    line-height:    1.05;
    letter-spacing: -0.01em;
  }

  .pubs__lead { font-size: var(--fs-body-lg); line-height: 1.7; }

  /* ── Spotlight ────────────────────────────────────────────── */
  .pubs__spotlight {
    background:            var(--color-brand-blue-light);
    border-radius:         28px;
    padding:               clamp(var(--space-8), 5vw, 64px);
    display:               grid;
    grid-template-columns: 380px 1fr;
    gap:                   clamp(var(--space-8), 4vw, 56px);
    align-items:           center;
  }

  /* Slight rotation as in the draft – this makes the cover look
     like a book laid on top instead of a placeholder. */
  .pubs__cover {
    display:       block;
    border-radius: var(--radius-lg);
    overflow:      hidden;
    box-shadow:    0 20px 48px rgba(35, 42, 207, 0.25);
    transform:     rotate(-2deg);
    transition:    transform var(--transition-base);
  }

  .pubs__cover:hover { transform: rotate(-2deg) translateY(-4px); }
  .pubs__cover img   { width: 100%; display: block; }

  .pubs__spotlight-body {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-4);
  }

  .pubs__badge {
    align-self:     flex-start;
    white-space:    nowrap;
    font-size:      12px;
    font-weight:    var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color:          var(--color-text-on-brand);
    background:     linear-gradient(135deg, var(--color-brand-blue), var(--color-accent-purple));
    border-radius:  var(--radius-pill);
    padding:        6px 14px;
  }

  .pubs__spotlight-title {
    font-size:   clamp(1.6rem, 1.1rem + 1.8vw, 2.25rem);
    line-height: 1.15;
    color:       var(--color-brand-blue-dark);
  }

  .pubs__spotlight-title a { color: inherit; }
  .pubs__spotlight-title a:hover { text-decoration: underline; }

  .pubs__spotlight-text {
    font-size:   var(--fs-body);
    line-height: 1.7;
    color:       var(--color-brand-blue-dark);
  }

  .pubs__meta {
    font-size:   var(--fs-small);
    font-weight: var(--fw-semibold);
    color:       var(--color-text-body);
  }

  .pubs__actions {
    display:    flex;
    flex-wrap:  wrap;
    gap:        var(--space-3);
    margin-top: var(--space-2);
  }

  .pubs__btn {
    font-family:     var(--font-display);
    font-size:       14px;
    font-weight:     var(--fw-bold);
    color:           var(--color-text-on-brand);
    background:      var(--color-brand-blue);
    border-radius:   var(--radius-pill);
    padding:         12px 28px;
    text-decoration: none;
    transition:      background var(--transition-fast);
  }

  .pubs__btn:hover { background: var(--color-brand-blue-dark); text-decoration: none; }

  .pubs__btn--ghost {
    color:      var(--color-brand-blue);
    background: transparent;
    border:     1.5px solid rgba(0, 82, 233, 0.35);
  }

  .pubs__btn--ghost:hover { background: rgba(255, 255, 255, 0.45); }

  /* ── List ─────────────────────────────────────────────────── */
  .pubs__list-head {
    border-bottom:  2px solid var(--color-text-heading);
    padding-bottom: 14px;
    margin-bottom:  var(--space-2);
  }

  .pubs__list-head h2 { font-size: 24px; }

  .pubs__row {
    display:               grid;
    grid-template-columns: 80px 110px 1fr;
    gap:                   var(--space-8);
    align-items:           center;
    padding:               24px 4px;
    border-bottom:         1px solid var(--color-border-subtle);
    text-decoration:       none;
    transition:            background var(--transition-fast);
  }

  .pubs__row:hover { background: #F7F9FE; text-decoration: none; }

  .pubs__row-year {
    font-size:   15px;
    font-weight: 800;
    color:       var(--color-brand-blue);
  }

  .pubs__row-cover {
    display:       block;
    height:        90px;
    border-radius: 10px;
    overflow:      hidden;
  }

  .pubs__row-cover img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
  }

  .pubs__row-body {
    display:        flex;
    flex-direction: column;
    gap:            4px;
  }

  .pubs__row-title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size:   18px;
    color:       var(--color-text-heading);
  }

  .pubs__row-authors { font-size: 13px; color: var(--color-text-muted); }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 900px) {
    .pubs__spotlight { grid-template-columns: 1fr; }
    .pubs__cover     { max-width: 300px; }
  }

  @media (max-width: 620px) {
    .pubs__row { grid-template-columns: 64px 1fr; }
    .pubs__row-cover { display: none; }
  }
</style>
