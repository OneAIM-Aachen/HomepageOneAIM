---
// src/layouts/CityLayout.astro
//
// Gemeinsames Layout für alle Standort-Seiten.
//
// BEWERBUNGSBEREICH:
//   showApplicationInfo={true} + program="aimConnect" oder "aimCode"
//   → lädt automatisch die passende Konfiguration aus application.ts
//   → Nur application.ts muss für Änderungen angefasst werden

import BaseLayout          from "./BaseLayout.astro";
import Hero                from "../components/sections/Hero.astro";
import CityTabs            from "../components/navigation/CityTabs.astro";
import type { CityData }   from "../data/cityData";
import { getApplicationData } from "../data/application";
import type { ProgramKey } from "../data/application";

interface Props {
  city:                 CityData;
  pageTitle:            string;
  description?:         string;
  /** Bewerbungsbereich im Hero anzeigen? */
  showApplicationInfo?: boolean;
  /**
   * Welches Programm soll angezeigt werden?
   * "aimConnect" (Standard) oder "aimCode"
   * Nur relevant wenn showApplicationInfo={true}
   */
  program?:             ProgramKey;
}

const {
  city,
  pageTitle,
  description,
  showApplicationInfo = false,
  program             = "aimConnect",
} = Astro.props;

const applicationData = showApplicationInfo
  ? getApplicationData(city.slug, program)
  : null;
---

<BaseLayout
  title={`${pageTitle} – ${city.displayName}`}
  description={description ?? `${pageTitle} am OneAIM-Standort ${city.displayName}.`}
>
  <Hero
    headline={city.heroHeadline}
    subtext={city.heroSubtext}
    applicationData={applicationData}
  />

  <CityTabs citySlug={city.slug} />

  <slot />
</BaseLayout>
