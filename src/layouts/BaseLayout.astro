---
// src/layouts/BaseLayout.astro
//
// Global layout. Includes the CookieBanner.
//
// TO DISABLE THE COOKIE BANNER:
//   Comment out <CookieBanner />.
//
// SELF-HOSTING GOOGLE FONTS (cleaner for GDPR, no banner needed):
//   1. Download Raleway from https://fonts.google.com/specimen/Raleway
//   2. Copy the files to public/fonts/
//   3. Replace the Google Fonts <link> below with @font-face in tokens.css
//   4. Comment out <CookieBanner />

import Header      from "../components/navigation/Header.astro";
import Footer      from "../components/navigation/Footer.astro";
import CookieBanner from "../components/ui/CookieBanner.astro";
import "../styles/global.css";

interface Props {
  title:        string;
  description?: string;
}

const {
  title,
  description = "OneAIM – Germany's first student-led interdisciplinary initiative in MedTech.",
} = Astro.props;

const pageTitle = title ? `${title} | OneAIM` : "OneAIM";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      Google Fonts – Raleway (400, 500, 600, 700).
      GDPR note: when loading from Google servers, the user's IP is
      transmitted. That is why the CookieBanner is shown.
      Alternative: self-host Raleway (public/fonts/) → then no banner needed.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a href="#page-content" class="skip-link">Zum Inhalt springen</a>

    <Header />

    <main id="page-content">
      <slot />
    </main>

    <Footer />

    <!-- Cookie banner: appears on the first visit.
         To disable: turn this line into a comment. -->
    <!-- CookieBanner disabled (request: no Google Fonts notice).
         To re-enable: remove the comment. -->
    <!-- <CookieBanner /> -->
  </body>
</html>
